        row:Left():TitleStack({ Title = "Auto Equip Best", Subtitle = "All stat wearables + titles: selected stat first, then bonus stats, rarity and tier." })
        row:Right():Toggle({ Value = (config.accessories and config.titles) == true, ValueChanged = function(self, value)
            config.accessories = value; config.titles = value; config.vanity = false; table.clear(attempts); saveSlayerConfig()
        end })
        local build = form:Row()
        build:Left():TitleStack({ Title = "Build Stat", Subtitle = "Maximize this exact stat; flat damage and Damage Factor are separate choices." })
        if #options > 0 then
            build:Right():PopUpButton({ Options = options, Value = table.find(options, config.accessoryBuild) or 1,
                ValueChanged = function(self, index)
                    if options[index] then config.accessoryBuild = options[index]; config.titleBuild = options[index]; saveSlayerConfig() end
                end })
        else build:Right():Label({ Text = "Catalog unavailable" }) end
        local profileNames={"Balanced","Slayer / Sword","Demon / Evil Art","Duelist","Technician","Tank","Sentinel","Phantom","Titan","Ascendant"}
        local profileRow=form:Row()
        profileRow:Left():TitleStack({Title="Build Profile",Subtitle="Bonus-stat tie breaker only; never overrides the selected Build Stat."})
        profileRow:Right():PopUpButton({Options=profileNames,Value=table.find(profileNames,config.smartProfile) or 1,
            ValueChanged=function(_,index)
                if profileNames[index] then config.smartProfile=profileNames[index];config.classFilter="Any";table.clear(attempts);saveSlayerConfig() end
            end})
    end
    task.spawn(function()
        local modeIndex = 0
        while state.running do
            local signature = config.accessoryBuild .. ":" .. config.titleBuild .. ":" .. config.classFilter .. ":" .. config.smartProfile
            if lastConfig ~= signature then table.clear(attempts); lastConfig = signature end
            if ready and (config.accessories or config.vanity or config.titles) then
                local ok, result = pcall(function()
                    local data = utility.GetData(LocalPlayer)
                    if not data then return "Waiting for player inventory" end
                    -- One request per tick. Re-read replicated slots before the next request.
                    for _ = 1, 3 do
                        modeIndex = modeIndex % 3 + 1
                        if modeIndex == 1 and config.accessories then return equipAccessories(data, "Stats") end
                        if modeIndex == 2 and config.vanity then return equipAccessories(data, "Vanity") end
                        if modeIndex == 3 and config.titles then return equipTitles(data) end
                    end
                    return nil
                end)
                state.equipmentStatus = ok and result or "Equipment error: " .. tostring(result)
            elseif ready then state.equipmentStatus = "Off" end
            task.wait(2)
        end
    end)
end

