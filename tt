do -- Build options come from the current game catalog, not a fixed stat list.
    local config = state.equipmentConfig
    config.accessoryBuild = config.accessoryBuild or "Additional Damage"
    config.titleBuild = config.titleBuild or "Additional Damage"
    config.classFilter = config.classFilter or "Any"
    local catalog, items, titles, controller, signal, utility, equipTypes
    local function isStatWearable(definition)
        if type(definition) ~= "table" or not equipTypes then return false end
        local kind = definition.EquipType
        if kind ~= equipTypes.Accessory and kind ~= equipTypes.Clothing and kind ~= equipTypes.Costume then return false end
        for _, value in pairs(definition.Stats or {}) do
            if type(value) == "number" and value ~= 0 then return true end
        end
        return false
    end
    local options, classes = {}, { "Any" }
    local ready, failure = pcall(function()
        local global = ReplicatedStorage.CAM.Global
        catalog = require(global.Types.StatTypes)
        items = require(global.Collectibles.Items)
        titles = require(global.Titles)
        controller = require(ReplicatedStorage.CAM.Client.Controllers.TitleController)
        signal = require(ReplicatedStorage.Communication.ServerAndClient.Signals.SignalEvent)
        utility = require(global.Utility)
        equipTypes = require(global.Menum).ItemEquipType
        local seen = {}
        local function add(name)
            if type(name) == "string" and not seen[name] then seen[name] = true; table.insert(options, name) end
        end
        for _, name in ipairs(catalog.StatKeys) do add(name) end
        for _, definition in pairs(items) do
            if isStatWearable(definition) then
                for name in pairs(definition.Stats or {}) do add(name) end
            end
        end
        for _, definition in pairs(titles.GetAll()) do
            for _, buff in ipairs(definition.buffs or {}) do add(buff.stat) end
        end
        table.sort(options)
        for _, name in ipairs(catalog.Classes or {}) do table.insert(classes, name) end
    end)
    state.equipmentStatus = ready and "Off" or "Catalog unavailable: " .. tostring(failure)
    local attempts, lastConfig = {}, nil
    local function requestAllowed(key)
        attempts[key] = (attempts[key] or 0) + 1
        return attempts[key] <= 3
    end
    local lowerIsBetter = { ["Stamina Drain Rate"] = true, ["Stamina Cost Factor"] = true,
        ["Water Stamina Cost Factor"] = true }
    local profiles = {
        ["Balanced"] = {},
        ["Slayer / Sword"] = {["Sword Damage Factor"]=6,["Breathing Damage Factor"]=5,["Additional Damage"]=5,["Additional Damage Factor"]=5},
        ["Demon / Evil Art"] = {["Evil Art Damage Factor"]=7,["Additional Damage"]=5,["Additional Damage Factor"]=5},
        ["Duelist"] = {["Additional Damage"]=7,["Additional Damage Factor"]=6,["Attack Speed Factor"]=5},
        ["Technician"] = {["Breathing Damage Factor"]=6,["Evil Art Damage Factor"]=6,["Cooldown Reduction Factor"]=6,["Max Stamina"]=5},
        ["Tank"] = {["Max Health"]=7,["Max Health Factor"]=7,["Damage Reduction"]=6,["Damage Reduction Factor"]=6},
        ["Sentinel"] = {["Block Points"]=7,["Block Regen"]=7,["Damage Reduction Factor"]=5},
        ["Phantom"] = {["Movement Speed Factor"]=6,["Dash Speed Factor"]=6,["Stamina Regen Speed"]=5},
        ["Titan"] = {["Max Health"]=6,["Max Stamina"]=6,["Max Health Factor"]=6},
        ["Ascendant"] = {["Additional Damage Factor"]=5,["Max Health"]=5,["Max Stamina"]=5,["Cooldown Reduction Factor"]=5},
    }
    config.smartProfile=config.smartProfile or "Balanced"
    local combatWeights = {["Additional Damage"]=3,["Additional Damage Factor"]=3,["Max Health"]=2,
        ["Max Health Factor"]=2,["Max Stamina"]=2,["Stamina Regen Speed"]=1.5,
        ["Health Regen Speed"]=1.5,["Damage Reduction"]=2,["Damage Reduction Factor"]=2,
        ["Block Points"]=1.5,["Block Regen"]=1.5,["Attack Speed Factor"]=2,
        ["Cooldown Reduction Factor"]=2,["Movement Speed Factor"]=1,["Stamina Cost Factor"]=1.5,
        ["Stamina Drain Rate"]=1.5}
    local scales={}
    local function recordScale(stats)
        for name,value in pairs(stats) do
            local numeric=value==true and 1 or tonumber(value)
            if numeric then scales[name]=math.max(scales[name] or 0,math.abs(numeric)) end
        end
    end
    if ready then
        for _,definition in pairs(items) do
            if isStatWearable(definition) then recordScale(definition.Stats or {}) end
        end
        for _,definition in pairs(titles.GetAll()) do
            for _,buff in ipairs(definition.buffs or {}) do recordScale({[buff.stat]=buff.amount}) end
        end
    end
    local function scoreStats(stats,primary)
        local total=0
        local weights=profiles[config.smartProfile] or profiles.Balanced
        for name,value in pairs(stats) do
            local amount=value==true and 1 or tonumber(value) or 0
            local weight=weights[name] or combatWeights[name] or 0.05
            if name:gsub(" Factor","")==tostring(primary):gsub(" Factor","") then weight+=8 end
            -- Keep non-build stats positive so a strict stat upgrade always wins.
            local normalized=amount/math.max(scales[name] or math.abs(amount),0.000001)
            total+=normalized*weight*(lowerIsBetter[name] and -1 or 1)
        end
        return total
    end
    state.scoreEquipmentStats=scoreStats
    local function primaryStatScore(stats,selected)
        local value=stats[selected]
        local amount=value==true and 1 or tonumber(value) or 0
        return lowerIsBetter[selected] and -amount or amount
    end
    local rarityMap = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mythic = 6 }
    local function getRarity(r) return type(r) == "number" and r or rarityMap[r] or 0 end
    local function sortCandidates(candidates)
        table.sort(candidates, function(a, b)
            if a.primary~=b.primary then return a.primary>b.primary end
            if a.score ~= b.score then return a.score > b.score end
            if a.rarity~=b.rarity then return a.rarity>b.rarity end
            if a.tier~=b.tier then return a.tier>b.tier end
            if a.equipped ~= b.equipped then return a.equipped end
            return tostring(a.id) < tostring(b.id)
        end)
    end
    local function equipAccessories(data, mode)
        local slots = data.Inventory.Accessories:FindFirstChild(mode)
        if not slots then return "Accessory slots unavailable" end
        local equipped = {}
        for _, slot in ipairs(slots:GetChildren()) do equipped[slot.Value] = true end
        local candidates, names = {}, {}
        for _, item in ipairs(data.Inventory.Inventory:GetChildren()) do
            local definition = items[item.Name]
            local id, amount = item:FindFirstChild("Id"), item:FindFirstChild("Amount")
            if isStatWearable(definition) and id and amount and amount.Value > 0
                and not names[item.Name] then
                local value = scoreStats(definition.Stats or {},config.accessoryBuild)
                local primary=primaryStatScore(definition.Stats or {},config.accessoryBuild)
                if primary>0 or value > 0 then
                    names[item.Name] = true
                    table.insert(candidates, { id = id.Value, primary=primary, score = value, rarity = getRarity(definition.Rarity), tier = tonumber(definition.Tier) or 0, equipped = equipped[id.Value] == true })
                end
            end
        end
        sortCandidates(candidates)
        local desired, count = {}, math.min(5, #candidates)
        for i = 1, count do desired[candidates[i].id] = true end
        for i = 1, count do
            local candidate = candidates[i]
            if not equipped[candidate.id] then
                for _, name in ipairs({ "One", "Two", "Three", "Four", "Five" }) do
                    local slot = slots:FindFirstChild(name)
                    if slot and not desired[slot.Value] then
                        if not requestAllowed(mode .. ":" .. tostring(candidate.id)) then
                            return "Accessory not confirmed; change Build or toggle Auto Equip to retry"
                        end
                        signal.ToServer("AccessoryEquip", name, candidate.id, mode)
                        return "Requested " .. mode .. " accessory; waiting for inventory"
                    end
                end
            end
        end
        return count == 0 and "No owned accessory improves this Build" or "Accessory selection up to date"
    end
    local function equipTitles(data)
        local candidates, equipped = {}, {}
        local slots = data.EquippedTitles.Boost
        for _, slot in ipairs(slots:GetChildren()) do equipped[slot.Value] = true end
        for id, definition in pairs(titles.GetAll()) do
            if controller.IsUnlocked(id) then
                local titleStats = {}
                for _, buff in ipairs(definition.buffs or {}) do
                    titleStats[buff.stat]=(titleStats[buff.stat] or 0)+(tonumber(buff.amount) or 0)
                end
                local value=scoreStats(titleStats,config.titleBuild)
                local primary=primaryStatScore(titleStats,config.titleBuild)
                if primary>0 or value > 0 then table.insert(candidates, { id = id, primary=primary, score = value, rarity = getRarity(definition.rarity), tier = tonumber(definition.tier) or 0, equipped = equipped[id] == true }) end
            end
        end
        sortCandidates(candidates)
        local desired, count = {}, math.min(titles.BoostSlots, #candidates)
        for i = 1, count do desired[candidates[i].id] = true end
        for i = 1, count do
            if not equipped[candidates[i].id] then
                for index = 1, titles.BoostSlots do
                    local slot = slots:FindFirstChild("Slot" .. index)
                    if slot and not desired[slot.Value] then
                        if not requestAllowed("Title:" .. candidates[i].id) then
                            return "Title not confirmed; change Build or toggle Auto Equip to retry"
                        end
                        controller.EquipBoost(candidates[i].id, index)
                        return "Requested title; waiting for equipped title update"
                    end
                end
            end
        end
        return count == 0 and "No unlocked title improves this Build" or "Title selection up to date"
    end
    state.installEquipmentUI = function(tab)
        local form = tab:PageSection({ Title = "Equipment Build (Accessories & Titles)" }):Form()
