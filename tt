            for _, info in ipairs(CollectionService:GetTagged("BossTag")) do
                local folder = info.Parent
                if folder and info:IsDescendantOf(workspace) and
                    (folder.Name == name or folder.Name == target.name or folder.Name == target.module) then
                    local spawnTime = info:GetAttribute("SpawnTime")
                    local despawnedAt = folder:GetAttribute("DespawnedAt")
                    if typeof(spawnTime) ~= "number" or typeof(despawnedAt) ~= "number" then
                        return prefix .. " — ETA unknown"
                    end
                    -- Same clock and calculation as the game's BossUI.
                    local remaining = math.max(0, math.ceil(spawnTime - (QuestUtility.Tick() - despawnedAt)))
                    if remaining == 0 and info:GetAttribute("OnlyAtNight") == true then
                        local cycle = require(ReplicatedStorage.CAM.Global.DayAndNightHandler)
                        if cycle.IsEnabled() and not cycle.IsNight() then return prefix .. " — Waiting for night" end
