local function purchaseDungeonSelection(entry)
    local points = tonumber(LocalPlayer:GetAttribute("RunPoints")) or 0
    if points < entry.cost then return false, "insufficient" end
    state.autoBuyStatus = string.format("Buying %s (%s points)", entry.name, tostring(entry.cost))
    if entry.chest then
        local prompt, model = findDungeonPrompt("Ouwigahara Chest", "ChestPrompt")
        if not prompt then return false, "unavailable" end
        local root = getCharacterRoot()
        if not root then return false, "character unavailable" end
        if moveSmooth(root, model:GetPivot() * CFrame.new(0, 0, 4), function()
            return state.running and state.autoBuyDungeon and prompt.Parent ~= nil
        end,state.movementMode,"Loot") then
            fireproximityprompt(prompt, prompt.HoldDuration)
            task.wait(1)
            return true
        end
        return false, "movement stopped"
    end
    local listing = Shop.itemsforsale and Shop.itemsforsale[entry.name]
    local liveCost = listing and listing.Price and tonumber(listing.Price.RunPoints)
    if not liveCost then return false, "not offered this run" end
    if points < liveCost then return false, "insufficient" end
    local ok, result = pcall(function()
        return SignalFunction.ToServer("PurchaseSelection", { [entry.name] = 1 })
    end)
    task.wait(0.6)
    return ok and result ~= false, not ok and tostring(result) or nil
