local function runBreathingStep()
    if not breathingValid() or state.breathingPaused then return end
    if not state.breathingStyle then error("No breathing style selected") end

    local style = state.breathingStyle

    if isBreathingLearned(style.powerValue) then
        state.stopBreathing(true)
        if breathingToggle then breathingToggle.Value = false end
        state.breathingStatus = style.name .. " already learned!"
        return
    end

    local root = getCharacterRoot()
    if not root then state.breathingStatus = "Waiting for character"; return end
    if state.questBusy or state.lootBusy then state.breathingStatus = "Waiting for previous action to finish"; return end

    local data = QuestUtility.GetData(LocalPlayer)
    if not data then state.breathingStatus = "Waiting for player data"; return end

    local currentPower = data.Powers.Breathing.Value
    if currentPower ~= "" and currentPower ~= style.powerValue then
        error("Another breathing is already learned: " .. currentPower)
    end

    local entry = getQuestEntry(style.questKey)

    if not entry then
        local missing = getMissingRequirements(style)
        if missing then
            local missingStr = ""
            for item, amount in pairs(missing) do
                missingStr = missingStr .. item .. " (Need " .. amount .. ") "
            end
            state.breathingStatus = "Farming missing: " .. missingStr
            
            local itemToTarget = {
                ["Demon Horns"] = "Hoyuzo Subordinate",
                ["Beast Core"] = "Beast Born Demon",
            }
            local targetName = "Hoyuzo Subordinate" -- fallback
            for item, _ in pairs(missing) do
                if itemToTarget[item] then
                    targetName = itemToTarget[item]
                    break
                end
            end
            
            local farmTarget
            for _, t in ipairs(targets) do
                if t.name == targetName then farmTarget = t; break end
            end
            if not farmTarget then error(targetName .. " not found in targets table") end
            
            state.breathingCombat = true
            if state.target ~= farmTarget then
                state.standAtQuestNpc = false
                state.currentMob = nil
                state.trackedMob = nil
                state.lastFarmCFrame = nil
                state.lastMobPosition = nil
                state.waitCFrame = nil
                state.waitSettled = false
                state.target = farmTarget
            end
            return
        end

        state.breathingCombat = false
        -- Cancel ANY active quest that might block breathing quest acceptance,
        -- not just same-category ones. The combat quest from farming Beast Born
        -- Demon has a different category and would otherwise slip through.
        local pdata = QuestUtility.GetData(LocalPlayer)
        local pquests = pdata and pdata:FindFirstChild("Quests")
        local pholder = pquests and pquests:FindFirstChild("Holder")
        if pholder then
            for _, pentry in ipairs(pholder:GetChildren()) do
                local pqs = pentry:FindFirstChild("QuestString")
                local pkey = pqs and pqs.Value
                if pkey and pkey ~= style.questKey then
                    local pinfo = Quests.Holder[pkey]
                    if pinfo and pinfo.NoCancel ~= true then
                        state.breathingStatus = "Cancelling active quest: " .. pkey
                        SignalEvent.ToServer("RemoveQuest", pkey)
                        if not breathingWait(function() return pentry.Parent == nil end, 3) then
                            error("Quest cancellation not confirmed")
                        end
                        return -- re-enter on next tick to continue
                    end
                end
            end
        end

        local eligible, why, blocking = Quests.CanAddQuest(LocalPlayer, style.questKey)
        if not eligible then
            state.breathingStatus = why == true and not blocking and "Waiting for quest cooldown"
                or "Cannot accept quest; check level 25 and requirements"
            return
        end

        local info2 = Quests.Holder[style.questKey]
        local position = type(info2.OfferNpc) == "string" and Regions.GetNpcSpawn(info2.OfferNpc)
        if typeof(position) ~= "Vector3" then error("Trainer position unavailable") end

        state.breathingStatus = "Visiting " .. info2.OfferNpc
        if not moveBreathing(root, CFrame.new(position + Vector3.new(0, 0, 4)), breathingValid) then return end
        task.wait(0.5) -- let NPC zone stream in after long-range teleport
        if not breathingValid() then return end

        state.breathingAwaitingAcceptance = true
        state.breathingStatus = "Requesting quest from " .. info2.OfferNpc

        -- Retry AddQuest every 0.5s until the server confirms or we time out.
        local deadline = os.clock() + 15
        local nextRequest = 0
        while os.clock() < deadline and breathingValid() do
            if getQuestEntry(style.questKey) then
                state.breathingAwaitingAcceptance = false
                state.breathingStatus = "Quest accepted!"
                return
            end
            if os.clock() >= nextRequest then
                SignalEvent.ToServer("AddQuest", style.questKey)
                nextRequest = os.clock() + 0.25
                state.breathingStatus = "Requesting quest... (" .. math.ceil(deadline - os.clock()) .. "s)"
            end
            task.wait(0.1)
        end
        state.breathingAwaitingAcceptance = false
        if getQuestEntry(style.questKey) then return end
        error("Quest rejected by server. Do you have enough Yen? (Toggle off/on to retry)")
        return
    end

    local step = nextTask(entry)
    local lock = state.breathingCombatLock
    if lock and lock.entry==entry and lock.quest==style.questKey then
        if lock.step.Parent and lock.step.Value.Value<lock.step.Max.Value then
            if step and step~=lock.step then
                state.breathingCombat=false
                state.breathingStatus="Waiting for quest progress to stabilize; trainee phase locked"
                if state.breathingDebug.reason~="Quest progress regressed after trainee phase; training travel blocked" then
                    state.logBreathing("Progress regression", "Quest progress regressed after trainee phase; training travel blocked")
                end
                return
            end
            step=lock.step
        else
            state.breathingCombat=false
            state.breathingStatus="Waiting for breathing reward confirmation"
            return
        end
    elseif lock then
        state.breathingCombatLock=nil
    end
    if not step then state.breathingStatus = "Waiting for reward..."; return end
    if state.breathingStepName~=step.Name then
        state.breathingStepName=step.Name
        state.breathingPhase=step.Name:find("Defeat",1,true) and "Trainee" or "Training"
        state.logBreathing("Step changed", "Server selected "..step.Name)
    end

    local code = step:FindFirstChild("Code") and step.Code.Value or step.Name
    -- The game's quest step Code values can differ from the codes in our
    -- breathingStyles tasks table.  Normalise before matching.
    local codeAliases = {
        ["Meditation"]      = "Meditate",
        ["Pushups"]         = "Push ups",
        ["Target Shooting"] = "Aim Training",
        ["Cup Game"]        = "Cup Training",
        ["Squat"]           = "Barbell squats",
    }
    code = codeAliases[code] or code
    state.breathingStatus = "Training: " .. step.Name

    local taskConfig = nil
    for _, t in ipairs(style.tasks) do
        if t.code == code then taskConfig = t; break end
    end
    if not taskConfig then
        if code:find("Trainee") or code == style.trainee or step.Name:find("Defeat") then
            if not state.breathingCombatLock then
                state.breathingCombatLock={entry=entry,quest=style.questKey,step=step}
                state.breathingPhase="Trainee"
                state.releaseNpcHold()
                state.logBreathing("Trainee locked", "Training finished; station trips disabled until trainee completion")
            end
            -- Store trainee target in state so the reference stays stable
            -- across repeated calls (same fix as Beast Born Demon farming).
            if not state.breathingTraineeTarget or state.breathingTraineeTarget.name ~= style.trainee then
                state.breathingTraineeTarget = { level = 25, name = style.trainee, runtimeName = style.trainee, zone = style.traineeZone, module = style.traineeModule, quest = style.questKey }
            end
            local traineeTarget = state.breathingTraineeTarget
            if state.target ~= traineeTarget then
                state.standAtQuestNpc = false
                state.currentMob = nil
                state.trackedMob = nil
                state.lastFarmCFrame = nil
                state.lastMobPosition = getTraineeSpawnPosition(style.traineeZone, style.traineeModule)
                state.waitCFrame = nil
                state.waitSettled = false
                state.target = traineeTarget
            end
            state.breathingCombat = true
            state.breathingStatus = "Defeating " .. style.trainee .. " (waiting at spawn if absent)"
            return
        end
        error("Unsupported training task: " .. code)
    end

    if state.breathingCombatLock and state.breathingCombatLock.entry==entry then
        state.logBreathing("Station trip blocked", "Trainee phase owns movement; refusing completed training station")
        return
    end

    state.breathingCombat = false
    if taskConfig.type == "minigame" or taskConfig.type == "barbell_squats" then
        doMinigameTask(taskConfig, step)
    elseif taskConfig.type == "collect" then
        doCollectTask(taskConfig, step)
    elseif taskConfig.type == "boulder_push" then
        -- Boulder Push works similarly to minigame
        doMinigameTask(taskConfig, step)
    elseif taskConfig.type == "parkour" then
        -- Automatically try to unlock required skills for parkour
        unlockSkill("Double Jump")
        task.wait(0.5)
        unlockSkill("Wall Climb")
        
        doParkourTask(taskConfig, step)
    else
        error("Unknown task type: " .. taskConfig.type)
    end
end

