function state.farmDestination(mobRoot, playerRoot)
    local distance = updateDistance(mobRoot, playerRoot)
    state.currentDistance = distance
    local offset, up = Vector3.new(0, 0, distance), Vector3.yAxis
    if state.farmMode == "Above" then
        offset, up = Vector3.new(0, distance, 0), Vector3.zAxis
    elseif state.farmMode == "Below" then
        offset, up = Vector3.new(0, -distance, 0), Vector3.zAxis
    elseif state.farmMode == "Behind" then
        offset = -mobRoot.CFrame.LookVector * distance
    else
        local delta = playerRoot.Position - mobRoot.Position
        local flat = Vector3.new(delta.X, 0, delta.Z)
        if flat.Magnitude > 0.1 then offset = flat.Unit * distance end
    end
    local desired = CFrame.lookAt(mobRoot.Position + offset, mobRoot.Position, up)
    -- Active monster/boss farming follows the live pose on every heartbeat.
    if state.movementMode=="Final" or ((state.autoFarm or state.autoBossFarm) and not state.breathingTraining
        and not state.crow1Pursuing and not state.autoDungeonFarm) then
        state.farmPoseHold = nil
        return desired
    end
    local hold = state.farmPoseHold
    local now = os.clock()
    if not hold or hold.mob ~= mobRoot or hold.player ~= playerRoot
        or hold.mode ~= state.farmMode or hold.distance ~= distance then
        hold = {mob = mobRoot, player = playerRoot, mode = state.farmMode,
            distance = distance, pose = desired, nextUpdate = now + 1.5}
        state.farmPoseHold = hold
    elseif now >= hold.nextUpdate then
        local displacement = (hold.pose.Position - desired.Position).Magnitude
        local facingChanged = hold.pose.LookVector:Dot(desired.LookVector) < 0.94
        if displacement > 1 or facingChanged then
            hold.pose = desired
            hold.nextUpdate = now + 1.5
        end
    end
    return hold.pose
end

