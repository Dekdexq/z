    ["second wind"] = 650000,
    ["medic"] = 640000,
    ["thick blood"] = 630000,
    ["second chance"] = 620000,
}

local function cardScore(card)
    local title = tostring(card:GetAttribute("Title") or card.Name)
    local description = tostring(card:GetAttribute("Description") or " ")
    local rarity = tonumber(card:GetAttribute("Rarity")) or 0
    local lowerTitle = string.lower(title)
    local lowerDescription = string.lower(description)
    
    -- User Requested Preferences
    if lowerTitle:find("barely hands",1,true) or lowerTitle:find("bare hands",1,true)
        or lowerTitle:find("bleeding floor",1,true) then
        return -99999999, "AVOID (User Requested)"
    end
    if lowerTitle:find("the horde",1,true) then
        return 99000000,"The Horde: first priority for point farming"
    end
    local multiplier=tonumber(lowerTitle:match("x%s*(%d+%.?%d*)%s*points"))
        or tonumber(lowerDescription:match("x%s*(%d+%.?%d*)%s*points"))
    if multiplier and multiplier>1 then
        return 9000000+(multiplier-1)*1000000+rarity, "points multiplier x"..tostring(multiplier)
    end

    local pointText = string.match(title, "%+([%d,]+)")
    local points = pointText and tonumber((string.gsub(pointText, ",", ""))) or nil
    if points and (string.find(lowerTitle, "trophy", 1, true)
        or string.find(lowerDescription, "point", 1, true)
        or string.find(lowerDescription, "score", 1, true)) then
        return 10000000 + points, string.format("direct points +%d", points)
    end
    local pointPriority = pointCardPriority[lowerTitle]
    if pointPriority then
        return pointPriority + rarity * 1000, "future point multiplier"
    end
    if (string.find(lowerDescription, "point", 1, true) or string.find(lowerDescription, "score", 1, true))
        and not string.find(lowerDescription, "lose", 1, true) then
        return 8500000 + rarity * 1000, "point-related effect"
    end
    if lowerTitle == "tribute" then
        return -500000, "costs points"
    end
        local fallback = fallbackCardPriority[lowerTitle] or 0
    if string.find(lowerTitle, "reroll", 1, true) then fallback = math.max(fallback, 760000) end
    
    -- Dynamically score any damage/attack/health cards if they aren't in the explicit list
    if fallback == 0 then
        if string.find(lowerDescription, "damage") or string.find(lowerDescription, "attack") or string.find(lowerDescription, "strength") or string.find(lowerDescription, "power") or string.find(lowerTitle, "damage") then
            fallback = 500000
        elseif string.find(lowerDescription, "heal") or string.find(lowerDescription, "health") or string.find(lowerDescription, "hp") then
            if not string.find(lowerTitle, "bleeding") then
                fallback = 400000
            end
        end
    end

    local combined=lowerTitle.." "..lowerDescription
    local character=LocalPlayer.Character
    local hum=character and character:FindFirstChildOfClass("Humanoid")
    local hp=hum and hum.MaxHealth>0 and hum.Health/hum.MaxHealth or 1
    local magnitude=tonumber(combined:match("(%d+%.?%d*)%%")) or 0
    if combined:find("damage",1,true) or combined:find("attack speed",1,true) then
        fallback=math.max(fallback,500000+magnitude*1000)
    end
    if combined:find("heal",1,true) or combined:find("regen",1,true) or combined:find("health",1,true) then
        fallback=math.max(fallback,400000+(1-hp)*350000+magnitude*1000)
    end
    if combined:find("revive",1,true) or combined:find("second chance",1,true) then
        fallback=math.max(fallback,550000+(1-hp)*250000)
    end
    local risk=combined:find("lose",1,true) or combined:find("drain",1,true)
        or combined:find("can't",1,true) or combined:find("cannot",1,true)
    if risk then fallback-=250000 end
    if lowerTitle=="skip" then fallback=10000 end
    return fallback+rarity*1000,"fallback: damage/survival benefit, current HP and risk"
end

local function chooseBestOuwigaharaCard()
    if not state.autoBestCard or workspace:GetAttribute("MinigameKey") ~= "Ouwigahara" then return end
    local offers = LocalPlayer:FindFirstChild("OuwigaharaOffers")
    if not offers or offers:GetAttribute("Picked") ~= nil then
        state.autoBestCardStatus = offers and "Waiting for next card hand" or "Waiting for card choices"
        return
    end
    if state.lastCardOffer == offers and os.clock() - state.lastCardPickAt < 2 then return end
            local bestCard, bestScore, bestReason
    for _, card in ipairs(offers:GetChildren()) do
        local score, reason = cardScore(card)
        if not bestCard or score > bestScore then
            bestCard, bestScore, bestReason = card, score, reason
        end
    end
    
    local hand={}
    for _,card in ipairs(offers:GetChildren()) do
        hand[#hand+1]=card.Name..":"..tostring(card:GetAttribute("Title"))
    end
    table.sort(hand)
    local signature=table.concat(hand,"|")
    local rerolls=tonumber(offers:GetAttribute("Rerolls"))
        or tonumber(LocalPlayer:GetAttribute("OuwigaharaRerolls")) or 0
    if state.cardRerollSignature==signature and os.clock()<state.cardRerollDeadline then
        state.autoBestCardStatus="Waiting for rerolled cards"
        return
    end
    -- Roll successive new hands until a point card appears or rolls run out.
    -- Do not repeatedly send the same request if the server rejected it.
    if bestScore and bestScore < 8500000 and rerolls>0 and state.cardRerollSignature~=signature then
        state.cardRerollSignature=signature
        state.cardRerollDeadline=os.clock()+3
        state.lastCardOffer = offers
        state.lastCardPickAt = os.clock()
        state.autoBestCardStatus = "Rerolling for point cards ("..rerolls.." left)"
        local remote = game.ReplicatedStorage.Communication.ServerAndClient.Signals.SignalEvent.Event
        pcall(function() remote:FireServer("OuwigaharaRequest", { action = "Reroll" }) end)
        return
    end

    if not bestCard then
        state.autoBestCardStatus = "Waiting for card choices"
        return
    end
    if bestScore<0 then
        state.autoBestCardStatus="Only avoided cards available; waiting for a new hand"
        return
    end
    local title = tostring(bestCard:GetAttribute("Title") or bestCard.Name)
    state.logDungeon("Card choice",title..": "..bestReason,{score=bestScore,rerolls=rerolls})
    state.lastCardOffer = offers
    state.lastCardPickAt = os.clock()
    state.autoBestCardStatus = string.format("Picking %s (%s%s)", title, bestReason,
        bestScore<8500000 and "; no usable reroll, safe fallback" or "")
    SignalEvent.ToServer("OuwigaharaRequest", { action = "Pick", id = bestCard.Name })
end
