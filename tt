local function filtergc_polyfill(type_str, options, return_first)
    if filtergc then
        local ok, result = pcall(filtergc, type_str, options, return_first)
        if ok and result then return result end
    end
    if not getgc or not debug or not (debug.getinfo or debug.info) then
        if return_first then return nil else return {} end
    end
    local ok, gc = pcall(getgc)
    if not ok or type(gc) ~= "table" then
        if return_first then return nil else return {} end
    end
    local result = {}
    for i = 1, #gc do
        local v = gc[i]
        if type(v) == type_str then
            local info_ok, info = pcall(function()
                if debug.getinfo then return debug.getinfo(v) end
                return {name=debug.info(v,"n")}
            end)
            if info_ok and info then
                local match = true
                if options.Name and info.name ~= options.Name then match = false end
                if match and options.Constants then
                    local const_ok, constants = pcall(function()
                        assert(debug.getconstants,"Constants inspection unavailable")
                        return debug.getconstants(v)
                    end)
                    if const_ok and constants then
                        for _, const in ipairs(options.Constants) do
                            if not table.find(constants, const) then match = false; break end
                        end
                    else
                        match = false
                    end
                end
                if match then
                    if return_first then return v end
                    table.insert(result, v)
                end
            end
        end
    end
    if return_first then return nil else return result end
end
local function CustomQueryDescendants(parent, query)
    local ok, matches = pcall(function() return parent:QueryDescendants(query) end)
    if ok then return matches end
    local res = {}
    if query == "ProximityPrompt" then
        for _, v in ipairs(parent:GetDescendants()) do if v:IsA("ProximityPrompt") then table.insert(res, v) end end
    elseif query == "Model:has(Humanoid)" then
        for _, v in ipairs(parent:GetDescendants()) do if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") then table.insert(res, v) end end
    elseif query == "Humanoid" then
        for _, v in ipairs(parent:GetDescendants()) do if v:IsA("Humanoid") then table.insert(res, v) end end
    elseif query == "Model:has(ProximityPrompt)" then
        for _, v in ipairs(parent:GetDescendants()) do if v:IsA("Model") and v:FindFirstChildWhichIsA("ProximityPrompt", true) then table.insert(res, v) end end
    else
        warn("Unknown query: " .. tostring(query))
    end
