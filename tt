local function runDungeonAutoBuy()
    if state.dungeonBuyBusy or state.dungeonBuyCompleted or not state.autoBuyDungeon
        or not isOuwigaharaRunFinished() or os.clock() < (state.dungeonBuyRetryAt or 0) then
        if state.autoBuyDungeon and not state.dungeonBuyBusy then state.autoBuyStatus = "Waiting for dungeon finish" end
        return
    end
    if state.dungeonCacheBusy or state.dungeonLeaveBusy or state.travelOwner
        or (state.autoOpenDungeonCaches and (not state.dungeonCacheCompleted
            or #pendingOuwigaharaCaches() > 0 or hasDungeonDrop())) then
        state.autoBuyStatus = "Waiting for caches and ground drops"
        return
    end
    state.dungeonBuyBusy = true
    task.spawn(function()
        local ok, err = pcall(function()
            local selected
            for _, entry in ipairs(DUNGEON_POINT_ITEMS) do
                if state.dungeonPointSelections[entry.name] then selected = entry; break end
            end
            if not selected then
                state.autoBuyStatus = "No point reward selected"
                state.dungeonBuyCompleted = true
                return
            end
            local prepared, prepareReason = prepareDungeonShop(selected)
            if not prepared then error(string.format("%s: %s", selected.name, tostring(prepareReason))) end
            local purchaseCount = 0
            while state.running and state.autoBuyDungeon do
                local pointsBefore = tonumber(LocalPlayer:GetAttribute("RunPoints")) or 0
                if pointsBefore < selected.cost then break end
                local bought, reason = purchaseDungeonSelection(selected)
                if not bought then error(string.format("%s: %s", selected.name, tostring(reason))) end
                task.wait(0.8)
                local pointsAfter = tonumber(LocalPlayer:GetAttribute("RunPoints")) or 0
                if pointsAfter >= pointsBefore then error("Purchase did not deduct points") end
                purchaseCount += 1
                state.autoBuyStatus = string.format(
                    "Bought %s x%d; %s points left", selected.name, purchaseCount, tostring(pointsAfter)
                )
            end
            if purchaseCount == 0 then
                state.autoBuyStatus = string.format("Not enough points for %s", selected.name)
            end
            state.dungeonBuyCompleted = true
            -- A purchased chest or reward may create another ground drop. Run the
            -- collection phase once more before allowing Auto Leave to continue.
            if state.autoOpenDungeonCaches then
                state.dungeonCacheCompleted = false
                state.dungeonDropEmptySince = nil
            end
        end)
        state.dungeonBuyBusy = false
        if not ok then
            state.dungeonBuyCompleted = false
            state.dungeonBuyRetryAt = os.clock() + 2
            state.autoBuyStatus = "Auto buy error: " .. tostring(err)
        end
    end)
end
