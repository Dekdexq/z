        if slot then
            if slot.Value==id.Value then return index end
            if slot.Value==0 then empty=empty or index
            elseif index~=state.weaponSlot then
                for _,owned in ipairs(bag:GetChildren()) do
                    local ownedId=owned:FindFirstChild("Id")
