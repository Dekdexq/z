    if pt then pt = pt:FindFirstChild("ParkourTraining") end
    if not pt then error("Parkour map not found") end
    
    local training = values:FindFirstChild("Training")
    local function validRun()
        return breathingValid() and getCharacterRoot() == root and training
            and training.Parent == values and values:FindFirstChild("Training") == training
    end
    local initial = Vector3.new(-68, 890.25, 4076.099)
    if not breathingWait(function()
        return validRun() and training:GetAttribute("Type") == "Parkour Dungeon"
            and (root.Position - initial).Magnitude < 35
    end, 15) then
        if not breathingValid() then return end
        error("Parkour entry teleport was not confirmed; retry training")
    end

    -- Positions from this game's Parkour client. Streaming can hide later switches.
    local route = {
        Vector3.new(-120.476, 898.435, 3853.299),
        Vector3.new(-212.057, 934.025, 3575.058),
        Vector3.new(-123.536, 952.635, 3278.08),
        Vector3.new(-34.632, 952.011, 3296.739),
        Vector3.new(-235.124, 971.707, 3426.915),
        Vector3.new(491.013, 951.202, 3239.977),
        Vector3.new(207.213, 1026.862, 2954.956),
    }
    local function settleAt(cf, seconds)
        if not validRun() then return false end
        if (root.Position - cf.Position).Magnitude > 12 then
            if not moveBreathing(root, cf, validRun) then return false end
        end
        local deadline = os.clock() + seconds
        repeat
            if not validRun() then return false end
            -- Observe the arrival instead of repeatedly forcing a rejected position.
            if (root.Position - cf.Position).Magnitude > 12 then
                return state.haltMovement("parkour arrival did not hold", root)
            end
            RunService.Heartbeat:Wait()
        until os.clock() >= deadline
        return true
    end
    for index, waypoint in ipairs(route) do
        if not validRun() then return end
        state.breathingStatus = string.format("Parkour: switch %d / 7", index)
        if not settleAt(CFrame.new(waypoint + Vector3.new(0, 3, 0)), 0.35) then return end
        local switch
        if not breathingWait(function()
            if not validRun() then return false end
            local folder = pt:FindFirstChild("Switchs")
            switch = folder and folder:FindFirstChild("Switch_" .. index)
            return switch and switch:IsA("Model") and switch:FindFirstChildWhichIsA("BasePart", true) ~= nil
        end, 8) then
            if not breathingValid() then return end
            error("Parkour switch did not stream in: " .. index)
        end
        local cf = switch:GetPivot() + Vector3.new(0, 3, 0)
        -- The server requires the character within 20 studs at receipt time.
        if not settleAt(cf, 0.35) then return end
        QuestRemote:FireServer("training_signaler", "StateChanged", switch)
        if not settleAt(cf, 0.25) then return end
        QuestRemote:FireServer("training_signaler", "StateChanged", switch)
        if not settleAt(cf, 0.2) then return end
    end
    
    local final
    breathingWait(function()
        final = pt:FindFirstChild("Final")
        return final ~= nil
    end, 5)
    
    if final then
        state.breathingStatus = "Parkour: finishing; waiting for quest credit"
        if not settleAt(final.CFrame + Vector3.new(0, 5, 0), 0.5) then return end
        QuestRemote:FireServer("training_signaler", "Stop")
    else
        error("Final part not found in Parkour Dungeon")
    end

    local completed = breathingWait(function()
        return step.Parent == nil or step.Value.Value >= step.Max.Value
    end, 10)

    if not completed then error("Server did not confirm task completion: " .. step.Name) end

    local released = breathingWait(function()
        return values:FindFirstChild("Training") == nil and values:FindFirstChild("pause_gameplay") == nil
    end, 18)

    state.ownsMinigame = values:FindFirstChild("Training") ~= nil
    if breathingValid() and not released then error("Training station did not release character") end

    state.breathingStatus = "Completed " .. taskConfig.code
end

