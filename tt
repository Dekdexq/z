local function nextTask(entry)
    local tasks = entry:FindFirstChild("Tasks")
    if not tasks then return nil end
    for _, step in ipairs(tasks:GetChildren()) do
        local progress, maximum = step:FindFirstChild("Value"), step:FindFirstChild("Max")
        local need = step:FindFirstChild("Need")
        local prerequisite = need and tasks:FindFirstChild(need.Value)
        local ready = not prerequisite or prerequisite.Value.Value >= prerequisite.Max.Value
        if progress and maximum and progress.Value < maximum.Value and ready then return step end
    end
    return nil
end

local function getInventoryItemAmount(itemName)
    local data = QuestUtility.GetData(LocalPlayer)
    if not data or not data:FindFirstChild("Inventory") then return 0 end
    local inv = data.Inventory:FindFirstChild("Inventory")
    if not inv then return 0 end
    local itemNode = inv:FindFirstChild(itemName)
    if not itemNode then return 0 end
    local amount = itemNode:FindFirstChild("Amount")
    return amount and amount.Value or 1
end

local function getMissingRequirements(style)
    if not style.requirements then return nil end
    local missing = {}
    for item, requiredAmount in pairs(style.requirements) do
        local currentAmount = getInventoryItemAmount(item)
        if currentAmount < requiredAmount then
            missing[item] = requiredAmount - currentAmount
        end
    end
    return next(missing) and missing or nil
end

