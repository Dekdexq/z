local function groundWaitCFrame(position, root)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = { root.Parent }
    for _, name in ipairs({ "Humanoids", "Chests" }) do
        local folder = workspace:FindFirstChild(name)
        if folder then excluded[#excluded + 1] = folder end
    end
    params.FilterDescendantsInstances = excluded
    params.RespectCanCollide = true
    local hit = workspace:Raycast(position + Vector3.new(0, 30, 0), Vector3.new(0, -300, 0), params)
    local humanoid = root.Parent:FindFirstChildOfClass("Humanoid")
    local height = root.Size.Y * 0.5 + (humanoid and humanoid.HipHeight or 2)
    if humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then height = height + 2 end
    -- If the map hasn't loaded (hit is nil), hover above the target position so we don't fall into the void while chunks stream in
    local stand = hit and hit.Position + Vector3.new(0, height + 0.1, 0) or (position + Vector3.new(0, 5, 0))
    if not hit then
        state.groundRefreshAt = os.clock() + 2
    end
    local forward = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    if forward.Magnitude < 0.1 then forward = Vector3.new(0, 0, -1) end
    return CFrame.lookAt(stand, stand + forward.Unit)
end

local function refreshTrackedDeath()
    local tracked = state.trackedMob
    if not tracked or tracked.done or tracked.target ~= state.target then return end
    local model = tracked.root.Parent
    local humanoid = model and model:FindFirstChildOfClass("Humanoid")
    if model and model:IsDescendantOf(workspace) and humanoid and humanoid.Health > 0 then
        tracked.position = tracked.root.Position
        return
    end
    -- Streaming-out is not a confirmed kill. Do not invent loot or release the
    -- current boss just because its model stopped replicating at this distance.
    if not model or not model:IsDescendantOf(workspace) or not humanoid then
        if state.autoBossFarm then state.bossLostAt = state.bossLostAt or os.clock() end
        return
    end
    tracked.done = true
    if state.autoFarm and state.autoQuest and tracked.target.quest then
        state.lastQuestKillKey=tracked.target.quest
        state.lastQuestKillAt=os.clock()
    end
    if state.autoBossFarm and tracked.target.code then
        state.bossProbeAfter[tracked.target.code] = os.clock() + 30
        state.bossFarmCurrentCode = nil
    end
    state.currentMob = nil
    state.lastMobPosition = tracked.position
    state.lootBatchOrigin = tracked.position
    state.lootBatchClosed = false
    state.lootAnchors = {}
    state.waitCFrame = nil
    state.waitSettled = false
    state.lootAnchors[#state.lootAnchors + 1] = { position = tracked.position, time = os.clock() }
    if #state.lootAnchors > 10 then table.remove(state.lootAnchors, 1) end
    if state.autoChest or state.autoLoot then
        state.lootDrainPending = true
        -- Loot can replicate after the death/quest-complete notification.
        local replicationWindow = state.autoBossFarm and 4 or 3
        state.lootPriorityUntil = math.max(state.lootPriorityUntil, os.clock() + replicationWindow)
        state.lootStatus = state.autoBossFarm and "Boss defeated; waiting for reward chest"
            or "Target defeated; waiting for drops"
    end
end

local function lootEligible(instance, kind)
    if not instance:IsDescendantOf(workspace) then return false end
    if kind == "Chest" then
        return instance:GetAttribute("IsOpen") ~= true
            and instance:GetAttribute("ChestState") ~= "Locked"
            and instance:GetAttribute("ChestState") ~= "Opened"
    end
    if instance:GetAttribute("DropClaimedBy") ~= nil then return false end
    local owner = instance:GetAttribute("DropOwnerUserId")
    if typeof(owner) == "number" and owner ~= LocalPlayer.UserId then return false end
    local reserved = instance:GetAttribute("DropReservedFor")
    return typeof(reserved) ~= "string"
        or string.find(reserved, "," .. LocalPlayer.UserId .. ",", 1, true) ~= nil
end

local function nearestLoot(root, includeCooldown)
    if state.lootBatchClosed and (state.autoFarm or state.autoBossFarm or state.breathingCombat) then return nil end
    local now = os.clock()
    for i = #state.lootAnchors, 1, -1 do
        if not state.lootBusy and now - state.lootAnchors[i].time > 45 then table.remove(state.lootAnchors, i) end
    end
    local origin = state.lootBatchOrigin or state.lastMobPosition
        or ((state.autoFarm or state.autoBossFarm) and state.lastFarmCFrame and state.lastFarmCFrame.Position) or root.Position
    local best, bestDistance
    local groups = {
        { enabled = state.autoChest, kind = "Chest", tag = gameSettings.Tags.Chest or "Chest" },
        { enabled = state.autoLoot, kind = "Drop", tag = gameSettings.Tags.LootDrop or "LootDrop" },
    }
    for _, group in ipairs(groups) do
        if group.enabled then
            local candidates = CollectionService:GetTagged(group.tag)
            if group.kind == "Chest" then
                local seen = {}
                for _, item in ipairs(candidates) do seen[item] = true end
                local chestFolder = workspace:FindFirstChild("Chests")
                if chestFolder then
                    for _, item in ipairs(CustomQueryDescendants(chestFolder, "Model:has(ProximityPrompt)")) do
                        if not seen[item] then
                            seen[item] = true
                            candidates[#candidates + 1] = item
                        end
                    end
                end
            end
            for _, item in ipairs(candidates) do
                local retry = state.lootAttempts[item]
                if lootEligible(item, group.kind) and (includeCooldown or not retry or now >= retry) then
                    local position = lootPosition(item)
                    local radius = state.autoBossFarm and math.max(state.lootRadius, 160) or state.lootRadius
                    local inArea = position and (position - origin).Magnitude <= radius
                    if position and not inArea then
                        for _, anchor in ipairs(state.lootAnchors) do
                            if (position - anchor.position).Magnitude <= radius then inArea = true; break end
                        end
                    end
                    if inArea then
                        if includeCooldown then
                            -- Count eligible items even while their landing animation or prompt is pending.
                            local distance = (position - root.Position).Magnitude
                            if not bestDistance or distance < bestDistance then
                                bestDistance = distance
                                best = { item = item, position = position, kind = group.kind }
                            end
                        end
                        for _, prompt in ipairs(CustomQueryDescendants(item, "ProximityPrompt")) do
                            local action = string.lower(prompt.ActionText)
                            -- Limit interaction to actual chest/drop prompts; never buy or dig.
                            local allowed = group.kind == "Chest" and (prompt.Name == "ChestPrompt" or action == "open")
                                or group.kind == "Drop"
                            if allowed and prompt.Enabled and prompt.MaxActivationDistance > 0 then
                                local promptPosition = lootPosition(prompt.Parent)
                                local distance = promptPosition and (promptPosition - root.Position).Magnitude
                                if distance and (not bestDistance or distance <= bestDistance) then
                                    bestDistance = distance
                                    best = { item = item, prompt = prompt, position = promptPosition, kind = group.kind }
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local nextPriorityScan = 0
local priorityCandidate
local function lootHasPriority()
    if state.breathingTraining then return false end
    refreshTrackedDeath()
    if not (state.autoChest or state.autoLoot) then return false end
    if state.lootDrainPending then return true end
    if state.lootBusy or os.clock() < state.lootPriorityUntil then return true end
    if os.clock() >= nextPriorityScan then
        nextPriorityScan = os.clock() + 0.1
