            local holders = gui:QueryDescendants("#InnerHolder")
            for _, holder in ipairs(holders) do
                for _, card in ipairs(holder:GetChildren()) do
                    local id = card.Name:match("^Hunt(.+)$")
                    local hunt = id and hunts:FindFirstChild(id)
                    local content = card:FindFirstChild("Content")
                    local rewards = content and content:FindFirstChild("Rewards")
                    local first = rewards and rewards:FindFirstChild("Reward1")
                    local amount = first and first:FindFirstChild("Amount")
                    local claim = card:FindFirstChild("Claim")
                    local expires = hunt and hunt:GetAttribute("ExpiresAt")
                    if card:IsA("GuiObject") and card.Visible and hunt and amount and claim
                        and not card:FindFirstChild("LevelCover") and typeof(expires) == "number"
                        and expires > workspace:GetServerTimeNow() then
                        local raw = amount.Text:gsub("<[^>]*>", ""):match("^%s*([%d,]+)")
                        local exp = raw and tonumber((raw:gsub(",", "")))
                        local quest = hunt:GetAttribute("Quest")
                        if exp and typeof(quest) == "string" then
                            candidates[#candidates + 1] = {
                                id = id, quest = quest, exp = exp, card = card, expires = expires,
                                y = card.AbsolutePosition.Y,
                            }
                        end
                    end
                end
            end
            if #candidates == 0 then
                -- Read the same replicated offers and reward formula used by HuntCard;
                -- a delayed UI animation must not hold the selector on the board.
                local quests = require(ReplicatedStorage.CAM.Global.Subsets.Gameplay.Quests)
                local bossHunts = require(ReplicatedStorage.CAM.Global.Subsets.Gameplay.Quests.BossHunts)
                local multipliers = require(ReplicatedStorage.CAM.Global.Multipliers)
                local settings = require(ReplicatedStorage.CAM.Global.gameSettings)
                local data = QuestUtility.GetData(LocalPlayer)
                local race = data and data:FindFirstChild("Race")
                local expData = data and data:FindFirstChild("Exp")
                local goal = expData and expData:FindFirstChild("Goal")
                local level = goal and goal.Value / settings.expPerLevel
                for _, hunt in ipairs(hunts:GetChildren()) do
                    local quest = hunt:GetAttribute("Quest")
                    local entry = bossHunts.Entry(hunt:GetAttribute("Boss"))
                    local side = bossHunts.Sides[hunt:GetAttribute("Side")]
                    local expires = hunt:GetAttribute("ExpiresAt")
                    if entry and side and race and table.find(side.Race, race.Value) and level
                        and level >= entry.MinLevel and (entry.MaxLevel == nil or level <= entry.MaxLevel)
                        and typeof(expires) == "number" and expires > workspace:GetServerTimeNow()
                        and typeof(quest) == "string" then
                        local info = quests.GetQuestInfo(quest)
                        local rewards = info and info.Rewards or bossHunts.Rewards(entry)
                        local factor = bossHunts.Factor(entry)
                        local mastery = info and info.MaxLevelMastery or bossHunts.MaxLevelMastery(entry)
                        local amount
                        if mastery and quests.AtLevelCap(LocalPlayer) then
