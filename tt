local pointCardPriority = {
    ["cursed coin"] = 9500000,
    ["gold rush"] = 9400000,
    ["bounty"] = 9300000,
    ["blood moon"] = 9200000,
    ["wager"] = 9100000,
    ["fortune"] = 9000000,
}
local fallbackCardPriority = {
    ["loaded dice"] = 800000,
    ["lucky draw"] = 790000,
    ["mulligan"] = 780000,
    ["ticket pack"] = 770000,
    ["prodigy"] = 700000,
    ["weapon master"] = 690000,
    ["heavy hitter"] = 680000,
    ["momentum"] = 670000,
