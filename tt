    do -- Crow 1: assign Crow without replacing combat items.
        function state.equipCrow1()
            if state.crow1Busy then return false, "Crow 1 is already running" end
            state.crow1Busy = true
            local ok, success, message = pcall(function()
                if not state.running then return false, "Hub is stopped" end
                local data = QuestUtility.GetData(LocalPlayer)
                local inventory = data and data:FindFirstChild("Inventory")
                local bag = inventory and inventory:FindFirstChild("Inventory")
                local toolbar = inventory and inventory:FindFirstChild("Toolbar")
                local crow = bag and bag:FindFirstChild("Crow")
                local id = crow and crow:FindFirstChild("Id")
                local amount = crow and crow:FindFirstChild("Amount")
                if not toolbar or not id or id.Value <= 0 or (amount and amount.Value <= 0) then
                    return false, "Crow or inventory data unavailable"
                end
                local protectedSlot = resolveWeaponSlot()
                local function safeSlot(index)
                    if index == protectedSlot then return false end
                    local slot = toolbar:FindFirstChild(toolbarNames[index])
                    if not slot then return false end
                    if slot.Value == 0 then return true end
                    for _, item in ipairs(bag:GetChildren()) do
                        local itemId = item:FindFirstChild("Id")
                        if itemId and itemId.Value == slot.Value then
                            local info = CombatItems[item.Name]
                            return info ~= nil and info.HasCombat ~= true
                        end
                    end
                    return false -- Unknown items must not be overwritten.
                end
                for index, name in ipairs(toolbarNames) do
                    local slot = toolbar:FindFirstChild(name)
                    if slot and slot.Value == id.Value and safeSlot(index) then
                        state.crow1Slot = index
                        return true, "Crow already in slot " .. index
                    end
                end
                local chosen
                for index, name in ipairs(toolbarNames) do
                    local slot = toolbar:FindFirstChild(name)
                    if safeSlot(index) and slot.Value == 0 then chosen = index; break end
                end
                if not chosen then
                    for index in ipairs(toolbarNames) do
                        if safeSlot(index) then chosen = index; break end
                    end
                end
                if not chosen then return false, "No non-combat slot available" end
                if not safeSlot(chosen) then return false, "Toolbar changed; try again" end
                local slot = toolbar:FindFirstChild(toolbarNames[chosen])
                local crowId = id.Value
                local remote = ReplicatedStorage.Communication.ServerAndClient.Signals.SignalEvent.Event
                remote:FireServer("Toolbar_Equip", toolbarNames[chosen], crowId)
                local deadline = os.clock() + 5
                repeat
                    task.wait(0.1)
                until not state.running or not slot.Parent or slot.Value == crowId or os.clock() >= deadline
                if slot.Parent and slot.Value == crowId then
                    state.crow1Slot = chosen
                    return true, "Crow assigned to slot " .. chosen
                end
                return false, "Crow assignment not confirmed; try again"
            end)
            state.crow1Busy = false
            state.crow1Status = ok and message or ("Crow 1 error: " .. tostring(success))
            return ok and success == true, state.crow1Status
        end
        function state.openCrow1()
            if state.crow1Opening then return false, "Crow 1 is already opening" end
            if state.crow1Active then return false, "Close the current Crow board before opening again" end
            state.crow1Opening = true
            state.crow1Active = true
            local ok, success, message = pcall(function()
                local assigned, reason = state.equipCrow1()
                if not assigned then return false, reason end
                local config = LocalPlayer:FindFirstChild("Items_Config")
                local equipped = config and config:FindFirstChild("Equipped")
                if not equipped then return false, "Equipment data unavailable" end
                local crowTool = require(ReplicatedStorage.ToolScripts.Crow.Crow)
