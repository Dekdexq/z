local function doMinigameTask(taskConfig, step)
    local root = getCharacterRoot()
    if not root then error("Character not found") end
    local values = QuestUtility.getvaluesfolder(LocalPlayer)
    local active = values and values:FindFirstChild("Training")
    if active then
        local expected = configToMarkerKey[taskConfig.code] or taskConfig.code
        if active:GetAttribute("Type") ~= expected then
            state.breathingStatus = "Waiting for current training to finish"
            return
        end
        state.ownsMinigame = true
        task.wait(1)
        if not breathingValid() then return end
        QuestRemote:FireServer("training_signaler", "Stop", true)
        if not breathingWait(function()
            return step.Parent == nil or step.Value.Value >= step.Max.Value
        end, 10) then error("Server did not confirm task completion: " .. step.Name) end
        breathingWait(function() return values:FindFirstChild("Training") == nil end, 8)
        state.ownsMinigame = values:FindFirstChild("Training") ~= nil
        return
    end

    local function nearestStation()
        local folder = workspace:FindFirstChild("Training") and workspace.Training:FindFirstChild(taskConfig.folder)
        local best, distance = nil, math.huge
        if folder then
            for _, candidate in ipairs(CustomQueryDescendants(folder, "ProximityPrompt")) do
                local position = lootPosition(candidate.Parent)
                if candidate.Enabled and position and (position-root.Position).Magnitude < distance then
                    best, distance = candidate, (position-root.Position).Magnitude
                end
            end
        end
        return best
    end

    local markerKey = configToMarkerKey[taskConfig.code] or taskConfig.code
    local markers = gameSettings.TrainingMarkerPositions[game.PlaceId]
    local defaults = gameSettings.TrainingMarkerPositions.Default
    local marker = (markers and markers[markerKey]) or (defaults and defaults[markerKey])
    local prompt = nearestStation()
    if not prompt then
        if not marker then error("Training marker unavailable: " .. markerKey) end
        state.breathingStatus = "Moving to " .. taskConfig.code
        if not moveBreathing(root, CFrame.new(marker.Position + Vector3.new(0, 3, 0)), breathingValid) then return end
    end
    local found = breathingWait(function()
        local folder = workspace:FindFirstChild("Training") and workspace.Training:FindFirstChild(taskConfig.folder)
        local distance = math.huge
        if folder then
            for _, candidate in ipairs(CustomQueryDescendants(folder, "ProximityPrompt")) do
                local position = lootPosition(candidate.Parent)
                if candidate.Enabled and position and (position - root.Position).Magnitude < distance then
                    distance = (position - root.Position).Magnitude
                    prompt = candidate
                end
            end
        end
        return prompt ~= nil
    end, 8)

    if not found then error("No available training station: " .. taskConfig.code) end

    local position = lootPosition(prompt.Parent)
    if not moveBreathing(root, CFrame.new(position + Vector3.new(0, 0, 2)), breathingValid) then return end
    if not breathingValid() then return end

    state.breathingStatus = "Starting " .. taskConfig.code

    -- Retry firing the prompt until the Training value appears.
    -- After a long teleport the first press often doesn't register.
    local trainingStarted = false
    local retryDeadline = os.clock() + 10
    local nextFire = 0
    while os.clock() < retryDeadline and breathingValid() do
        if values:FindFirstChild("Training") then
            trainingStarted = true
            break
        end
        if os.clock() >= nextFire then
            if prompt and prompt.Parent then
                if (root.Position-position).Magnitude > prompt.MaxActivationDistance then
                    error("Training arrival was not confirmed: " .. taskConfig.code)
                end
                pcall(function() prompt:InputHoldBegin() end)
                task.wait(prompt.HoldDuration + 0.1)
                if not breathingValid() then
                    pcall(function() prompt:InputHoldEnd() end)
                    return
                end
                pcall(fireproximityprompt, prompt, prompt.HoldDuration)
                pcall(function() prompt:InputHoldEnd() end)
            end
            nextFire = os.clock() + 1
        end
        task.wait(0.15)
    end

    if not trainingStarted then
        error("Training did not start: " .. taskConfig.code)
    end

    state.ownsMinigame = true
    task.wait(1)
    if not breathingValid() then return end

    QuestRemote:FireServer("training_signaler", "Stop", true)

    local completed = breathingWait(function()
        return step.Parent == nil or step.Value.Value >= step.Max.Value
    end, 20)

    if not completed then error("Server did not confirm task completion: " .. step.Name) end

    local released = breathingWait(function()
        return values:FindFirstChild("Training") == nil and values:FindFirstChild("pause_gameplay") == nil
    end, 18)

    state.ownsMinigame = values:FindFirstChild("Training") ~= nil
    if breathingValid() and not released then error("Training station did not release character") end

    state.breathingStatus = "Completed " .. taskConfig.code
end

local function doCollectTask(taskConfig, step)
    local root = getCharacterRoot()
    if not root then error("Character not found") end

    -- Teleport to the Underwater Rocks marker position first
    local markerKey = configToMarkerKey[taskConfig.code] or taskConfig.code
    local markers = gameSettings.TrainingMarkerPositions[game.PlaceId]
    local defaults = gameSettings.TrainingMarkerPositions.Default
    local marker = (markers and markers[markerKey]) or (defaults and defaults[markerKey])
    if marker then
        state.breathingStatus = "Moving to " .. taskConfig.code
        if not moveBreathing(root, CFrame.new(marker.Position + Vector3.new(0, 3, 0)), breathingValid) then return end
    end

    -- The game spawns Sea Crystal pickups with ProximityPrompts.
    -- Find and interact with them until the quest step is complete.
    state.breathingStatus = "Collecting " .. taskConfig.code
    local deadline = os.clock() + 120

    while os.clock() < deadline and breathingValid() do
        -- Check if step is already done
        if step.Parent == nil or step.Value.Value >= step.Max.Value then
            state.breathingStatus = "Completed " .. taskConfig.code
            return
        end

        root = getCharacterRoot()
        if not root then task.wait(0.5); continue end

        -- Find the nearest ProximityPrompt pickup in workspace
        local bestPrompt, bestPosition, bestDist = nil, nil, math.huge
        for _, obj in ipairs(CustomQueryDescendants(workspace, "ProximityPrompt")) do
            if obj:IsA("ProximityPrompt") and obj.Enabled
                and (obj.ObjectText == "Sea Crystal" or (obj.Parent and string.find(obj.Parent.Name, "Sea Crystal"))) then
                local pos = lootPosition(obj.Parent)
                if pos then
                    local dist = (root.Position - pos).Magnitude
                    if dist < bestDist then
                        bestPrompt = obj
                        bestPosition = pos
                        bestDist = dist
                    end
                end
            end
        end

        if bestPrompt and bestPosition then
            state.breathingStatus = "Picking up Sea Crystal (" .. step.Value.Value .. "/" .. step.Max.Value .. ")"
            if not moveBreathing(root, CFrame.new(bestPosition + Vector3.new(0, 0, 1)), breathingValid) then return end
            task.wait(0.15)
            if bestPrompt.Parent and bestPrompt.Enabled then
                pcall(fireproximityprompt, bestPrompt, bestPrompt.HoldDuration)
            end
            task.wait(0.5)
        else
            -- No pickups found yet, stay near marker and wait for spawns
            state.breathingStatus = "Waiting for Sea Crystal spawns (" .. step.Value.Value .. "/" .. step.Max.Value .. ")"
            if marker then
                local waitCf = CFrame.new(marker.Position + Vector3.new(0, 3, 0))
                if not moveBreathing(root, waitCf, breathingValid) then return end
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
            task.wait(0.5)
        end
    end

    if step.Value.Value < step.Max.Value then
        error("Collection timeout: " .. step.Value.Value .. "/" .. step.Max.Value)
    end
end

