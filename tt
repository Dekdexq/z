function state.queueBossStream(target, position)
    if not workspace.StreamingEnabled or not state.running or not state.autoBossFarm
        or state.bossFarmSelections[target.code] ~= true then return false end
    local requests = state.bossStreamRequests
    local previous = requests[target.code]
    if previous and previous.pending then return true end
    if state.bossStreamBusy or (previous and os.clock() < previous.nextTryAt) then return false end
    position = position or getSpawnPosition(target)
    if typeof(position) ~= "Vector3" then return false end
    local request = {pending = true, nextTryAt = os.clock() + 10, position = position}
    requests[target.code] = request
    state.bossStreamBusy = request
    state.bossSearchStatus = "Loading distant boss area: " .. target.name
    task.spawn(function()
        local identity = getthreadidentity()
        setthreadidentity(2)
        local ok, err = pcall(function() LocalPlayer:RequestStreamAroundAsync(position, 3) end)
        setthreadidentity(identity)
        request.pending, request.ok, request.completedAt = false, ok, os.clock()
        request.error = not ok and tostring(err) or nil
        state.mobScanCache = {}
        if state.bossStreamBusy == request then state.bossStreamBusy = nil end
        state.bossSearchStatus = ok and ("Area checked: " .. target.name)
            or ("Area loading failed: " .. tostring(err))
    end)
    return true
end

function state.bossApproachReady(target, living)
    local root = getCharacterRoot()
    if not root then return false end
    if not workspace.StreamingEnabled or (root.Position - living.Position).Magnitude <= 300 then return true end
    local request = state.bossStreamRequests[target.code]
    if request and request.ok and request.completedAt and os.clock() - request.completedAt < 8 then return true end
    state.queueBossStream(target, living.Position)
    return false
end


