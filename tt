local function tryAcceptSelectedQuest()
    if state.breathingTraining then return end
    if state.questBusy or state.lootBusy or not state.running or not state.autoFarm or not state.autoQuest then
        return
    end
    local target = state.target
    local quest = target and target.quest
    if not quest or not Quests.Holder[quest] then
        state.questStatus = "No quest for selected monster"
        return
    end
    local phase=selectedQuestPhase(quest)
    local oldQuest, oldKey, oldInfo = mismatchedCombatQuest(quest)
    if not oldQuest and (phase=="Wait" or phase=="Hunt") then
        state.questStatus = phase=="Hunt" and "Quest active; finish objectives before returning" or "Checking quest completion; staying here"
        if phase=="Hunt" then
            state.standAtQuestNpc=false
            state.releaseNpcHold()
            local spawn=not nearestLivingTarget(target) and getSpawnPosition(target)
            if spawn and not state.questStreamBusy and os.clock()>=state.questStreamNextAt then
                state.questStreamNextAt=os.clock()+5
                state.questStreamBusy=true
                state.questStreamStartedAt=os.clock()
                local token={};state.questStreamToken=token
                task.spawn(function()
                    local identity=getthreadidentity();setthreadidentity(2)
                    pcall(function()LocalPlayer:RequestStreamAroundAsync(spawn,3)end)
                    setthreadidentity(identity)
                    if state.questStreamToken==token then state.questStreamBusy=false end
                    state.mobScanCache={}
                end)
                state.questStatus="Quest active; loading selected monster area"
            end
        end
        return
    end
    if lootHasPriority() then
        state.questStatus = "Waiting for loot collection first"
        return
    end
    if oldQuest then
        if oldInfo.NoCancel == true then
            state.questStatus = "Current quest cannot be abandoned: " .. oldQuest.Name
            return
        end
        if os.clock() - state.lastQuestCancel < 0.5 then return end
        state.questBusy = true
        state.lastQuestCancel = os.clock()
        state.questStatus = "Abandoning mismatched quest: " .. oldQuest.Name
        local cancelTarget = target
        -- Native quest cancel UI sends the replicated entry name, not QuestString.
        local oldName = oldQuest.Name
        local ok, err = pcall(function()
            if state.running and state.autoFarm and state.autoQuest and state.target == cancelTarget then
                SignalEvent.ToServer("RemoveQuest", oldName)
                local deadline = os.clock() + 2.5
                repeat
                    task.wait(0.05)
                    if not state.running or state.target ~= cancelTarget or not state.autoFarm or not state.autoQuest then return end
                    local remaining, remainingKey = mismatchedCombatQuest(quest)
                    if not remaining or remainingKey ~= oldKey then
                        state.questStatus = "Previous quest removed; accepting " .. target.name
                        state.lastQuestRequest = -math.huge
                        return
                    end
                until os.clock() >= deadline
                state.questStatus = "Waiting for quest cancellation; retrying"
            end
        end)
        state.questBusy = false
        if not ok then
            state.questStatus = "Quest cancellation error; retrying"
            warn("[Auto Quest] " .. tostring(err))
        end
        return
    end
    if os.clock() - state.lastQuestRequest < 0.25 then
        return
    end

    local checkOk, canAdd, reason, blockingQuest = pcall(Quests.CanAddQuest, LocalPlayer, quest)
    local waitingCooldown = checkOk and canAdd == false and reason == true and blockingQuest == nil
    if not checkOk or (canAdd ~= true and not waitingCooldown) then
        state.questStatus = "Not eligible / cooldown / another quest active"
        return
    end
    local info = Quests.Holder[quest]
    local position = type(info.OfferNpc) == "string" and Regions.GetNpcSpawn(info.OfferNpc)
    local root = getCharacterRoot()
    if not root or typeof(position) ~= "Vector3" then
        state.questStatus = "Quest NPC unavailable"
        return
    end
    state.questBusy = true
    state.lastQuestRequest = os.clock()
    local function stillSelected()
        return state.running and not state.breathingTraining and state.autoFarm and state.autoQuest and state.target == target
            and getCharacterRoot() == root
    end
    local ok, err = pcall(function()
        state.questStatus = "Visiting " .. info.OfferNpc
        mouse1release()
        local npcDestination = CFrame.new(position + Vector3.new(0, 0, 4))
        if (root.Position-npcDestination.Position).Magnitude>6 then
            if not moveSmooth(root, npcDestination, function()
                return stillSelected() and selectedQuestPhase(quest)=="Accept"
            end,"World","QuestNPC") then return end
        end
        if not state.holdNpcPosition(root, npcDestination) then return end
        -- Let movement replication catch up before the first distance-checked request.
        local nextRequest = os.clock()
        local confirmationDeadline = os.clock() + 8
        local requests = 0
        while stillSelected() do
            if selectedQuestPhase(quest) == "Hunt" then
                state.observedQuest = quest
                state.observedQuestState = "Doing"
                state.standAtQuestNpc = false
                state.releaseNpcHold()
                state.waitCFrame=nil
                state.lastFarmCFrame=nil
                state.waitSettled=false
                state.questStatus = "Quest accepted; hunting " .. target.name
                -- The farm worker owns the next trip, including its travel cooldown.
                return
            end
            if (root.Position - npcDestination.Position).Magnitude > 6 then
                state.questStatus = "Returning to quest NPC before retry"
                if not moveSmooth(root, npcDestination, function()
                    return stillSelected() and selectedQuestPhase(quest)=="Accept"
                end,"World","QuestNPC") then return end
                nextRequest = os.clock()
            end
            local eligible, why, blocking = Quests.CanAddQuest(LocalPlayer, quest)
            if eligible == true then
                if os.clock() >= confirmationDeadline then
                    state.questStatus = "Quest not confirmed; revisiting NPC and retrying"
                    return
                end
                if os.clock() >= nextRequest then
                    SignalEvent.ToServer("AddQuest", quest)
                    requests += 1
                    nextRequest = os.clock() + 0.25
                end
                state.questStatus = "Waiting for quest confirmation (attempt " .. requests .. ")"
            elseif eligible == false and why == true and blocking == nil then
                confirmationDeadline = os.clock() + 8
                local data = QuestUtility.GetData(LocalPlayer)
                local quests = data and data:FindFirstChild("Quests")
                local lastTime = quests and quests:FindFirstChild("LastTime")
                local cooldown = math.max(Quests.QuestCD, info.AcceptCooldown or 0)
                local remaining = lastTime and math.max(0, cooldown - (QuestUtility.Tick() - lastTime.Value))
                state.questStatus = remaining and string.format("At NPC; cooldown %.1fs", remaining)
                    or "At NPC; waiting for quest cooldown"
            else
                state.questStatus = "Quest unavailable / another quest active"
                return
            end
            task.wait(0.05)
        end
    end)
    if not state.standAtQuestNpc or not stillSelected() then state.releaseNpcHold() end
    state.questBusy = false
    if not ok then
        state.questStatus = "Quest error; retrying later"
        warn("[Auto Quest] " .. tostring(err))
    end
end

