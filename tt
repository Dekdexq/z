local function loadZiiq(source)
    -- PlayerGui remains accessible to ordinary UI/module callback threads.
    -- Hidden/CoreGui instances can lose Plugin capability after game module calls.
    local parentStart = source:find("    -- Priority: gethui", 1, true)
    local parentEnd = parentStart and source:find("\n    self._sg = sg", parentStart, true)
    if parentStart and parentEnd then
        source = source:sub(1, parentStart - 1)
            .. "    sg.Parent = lp:WaitForChild('PlayerGui')\n"
            .. source:sub(parentEnd + 1)
    end
    -- UI animation errors must never prevent dropdown/toggle callbacks.
    local start = source:find("local function tw(", 1, true)
    local finish = start and source:find("\nend", start, true)
    assert(start and finish, "Unsupported ZiiqLib tween helper; update UI adapter")
    local safeTween = [==[
local function tw(obj, props, dur, style, dir)
    local ok = pcall(function()
        TweenService:Create(obj,
            TweenInfo.new(dur or .18, style or Enum.EasingStyle.Quint,
                dir or Enum.EasingDirection.Out), props):Play()
    end)
    if not ok then
        -- Some executor event threads cannot pass UI instances to TweenService.
        -- Apply the final appearance directly; gameplay callbacks still run.
        for property, value in pairs(props) do
            pcall(function() obj[property] = value end)
        end
    end
end
]==]
    source = source:sub(1, start - 1) .. safeTween .. source:sub(finish + 4)
    return assert(loadstring(source, "Slayer Ziiq UI"))()
end
