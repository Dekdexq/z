    if state.questStreamBusy and os.clock()-state.questStreamStartedAt>8 then
        state.questStreamBusy=false;state.questStreamToken=nil
        state.questStreamNextAt=os.clock()+2;state.respawnSearchPending=true
        state.recoveryStatus="Area loading timed out; retrying target recovery"
    end
    local preload=state.preloadTravel
    if preload and preload.pending and preload.startedAt and os.clock()-preload.startedAt>8 then
        if state.travelOwner==preload then state.travelOwner=nil end
        state.preloadTravel=nil;state.movementRetryAt=os.clock()+2
        state.recoveryStatus="Travel loading timed out; retrying in 2s"
    end
    if not state.respawnSearchPending or state.questBusy or state.travelOwner or state.defenseBusy
        or state.lootBusy or state.isHealing or lootHasPriority() then return end
    if not state.questHuntTripAllowed() then state.recoveryStatus="Waiting for confirmed quest";return end
    local living=nearestLivingTarget(state.target)
    if living then
        if (root.Position-living.Position).Magnitude<=120 then
            state.respawnSearchPending=false;state.recoveryStatus="Target found; farming resumed"
        else state.recoveryStatus="Target found; returning after respawn" end
        return
    end
    -- Recovery travel is only for ordinary quest mobs, never an unspawned boss.
    if state.smartIsBoss(state.target) then state.recoveryStatus="Waiting for boss / area loading";return end
    local position=getSpawnPosition(state.target)
    if not position then state.recoveryStatus="Target area unavailable";return end
    if (root.Position-position).Magnitude<=200 then
        state.respawnSearchPending=false;state.recoveryStatus="At monster area; waiting for spawn";return
    end
    state.recoveryStatus="Returning to monster area after respawn"
    local target=state.target
    if moveSmooth(root,CFrame.new(position+Vector3.new(0,5,0)),function()
        return state.running and state.autoFarm and state.target==target and getCharacterRoot()==root
            and state.questHuntTripAllowed()
    end,"World","QuestHunt") then
        state.respawnSearchPending=false;state.recoveryStatus="Area reached; scanning monsters"
    end
end

