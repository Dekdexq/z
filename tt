nearestLivingTarget = function(target)
    -- Keep the exact actor, rather than switching to another same-name NPC
    -- when a skill or dodge changes which one is nearest.
    local tracked=state.trackedMob
    local locked=tracked and not tracked.done and tracked.root
    local lockedModel=locked and locked.Parent
    local hum=lockedModel and lockedModel:FindFirstChildOfClass("Humanoid")
    local selected=tracked and tracked.target
    if selected and target and (selected==target or (selected.code and selected.code==target.code))
        and lockedModel and lockedModel.Name==(target.runtimeName or target.name)
        and lockedModel:IsDescendantOf(workspace) and hum and hum.Health>0
        and hum:GetState()~=Enum.HumanoidStateType.Dead then return locked end
    if state.autoBossFarm and tracked and not tracked.done and selected and target
        and (selected==target or (selected.code and selected.code==target.code)) then return nil end
    local playerRoot = getCharacterRoot()
    local humanoids = workspace:FindFirstChild("Humanoids")
    local regions = humanoids and humanoids:FindFirstChild("Regions")
    if not regions or not playerRoot then
        return nil
    end

    local nearest
    local nearestDistance = math.huge
    local wantedName = target.runtimeName or target.name
    state.mobScanCache = state.mobScanCache or {}
    local cached = state.mobScanCache[wantedName]
    if not cached or cached.root ~= regions or os.clock() >= cached.expires then
        local selector = string.format('Model[Name = %q]:has(Humanoid)', wantedName)
        local queryOk, models = pcall(function() return regions:QueryDescendants(selector) end)
        if not queryOk then models = CustomQueryDescendants(regions, "Model:has(Humanoid)") end
        cached = { root = regions, models = models, expires = os.clock() + 0.05 }
        state.mobScanCache[wantedName] = cached
    end
    local models = cached.models
    for _, model in ipairs(models) do
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart")
        local alive = humanoid
            and humanoid.Health > 0
            and humanoid:GetState() ~= Enum.HumanoidStateType.Dead
        if model.Name == wantedName and model:IsDescendantOf(regions) and alive and root and root.Parent == model then
            local distance = (playerRoot.Position - root.Position).Magnitude
            if distance < nearestDistance then
                nearest = root
                nearestDistance = distance
            end
        end
    end
    return nearest
end

local function getSpawnPosition(target)
    local content = ReplicatedStorage:FindFirstChild("Ouwland")
    content = content and content:FindFirstChild("Content")
    local zone = content and content:FindFirstChild(target.zone)
    local active = zone and zone:FindFirstChild("ActiveNpcs")
    if target.area then
        active = active and active:FindFirstChild(target.area)
    end
    local module = active and active:FindFirstChild(target.module)
    if not module or not module:IsA("ModuleScript") then
        return nil
    end

    local ok, config = pcall(require, module)
    if not ok or type(config) ~= "table" then
        return nil
    end

    local spawning = config.SendOver and config.SendOver.Spawning
    if not spawning then
        return nil
    end
    local function positionOf(value)
        if typeof(value) == "Vector3" then return value end
        if typeof(value) == "CFrame" then return value.Position end
        return nil
    end
    if positionOf(spawning.Center) then
        return positionOf(spawning.Center)
    end
    if spawning.Locations and spawning.Locations[1] then
        return positionOf(spawning.Locations[1])
    end
    return nil
end

