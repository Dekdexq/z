local function selectedBossCount()
    local count = 0
    for _, target in ipairs(bossFarmTargets) do
        if state.bossFarmSelections[target.code] == true then count += 1 end
    end
    return count
end

local function updateBossFarmTarget()
    if not state.autoBossFarm then return end
    if state.travelOwner or state.defenseBusy or state.defenseMoving then return end
    refreshTrackedDeath()
    if os.clock()<(state.movementRetryAt or 0) then
        state.bossFarmIdle=true
        state.bossFarmStatus=state.distanceStatus
        return
    end
    if state.lootBusy or lootHasPriority() then
        state.bossFarmStatus = "Collecting boss chest and drops before next target"
        return
    end
    if selectedBossCount() == 0 then
        clearBossFarmMovement()
        state.bossFarmCurrentCode = nil
        state.bossFarmIdle = true
        state.bossFarmStatus = "Select at least one Boss / Mini Boss"
        return
    end
    local current = state.bossFarmCurrentCode and bossFarmByCode[state.bossFarmCurrentCode]
    local living = current and state.bossFarmSelections[current.code] and nearestLivingTarget(current)
    if living then
        state.bossLostAt = nil
        state.bossFarmIdle = not state.bossApproachReady(current, living)
        state.bossFarmStatus = state.bossFarmIdle and ("Loading arrival area: " .. current.name) or ("Fighting " .. current.name)
        return
    end
    if current and state.bossFarmSelections[current.code] then
        state.bossLostAt = state.bossLostAt or os.clock()
        local tracked=state.trackedMob
        local unresolved=tracked and not tracked.done and tracked.target and tracked.target.code==current.code
        if unresolved or os.clock() - state.bossLostAt < 4 then
            state.bossFarmIdle = true
            state.queueBossStream(current, state.trackedMob and state.trackedMob.position)
            state.bossFarmStatus = "Target locked; waiting for live/death confirmation: " .. current.name
            return
        end
    end
    -- Round robin among selected, visibly living targets only. Timers do not prove a spawn.
    local count = #bossFarmTargets
    local cursor = state.bossFarmCursor or 0
    for offset = 1, count do
        local index = (cursor + offset - 1) % count + 1
        local target = bossFarmTargets[index]
        local found = state.bossFarmSelections[target.code] and nearestLivingTarget(target)
        if found then
            clearBossFarmMovement()
            state.bossFarmCursor = index
            state.bossFarmCurrentCode = target.code
            state.target = target
            state.trackedMob={root=found,target=target,position=found.Position,done=false}
            state.bossFarmIdle = not state.bossApproachReady(target, found)
            state.bossFarmStatus = state.bossFarmIdle and ("Loading arrival area: " .. target.name) or ("Targeting " .. target.name)
            return
        end
    end
    if not state.bossFarmIdle then clearBossFarmMovement() end
    state.bossFarmCurrentCode = nil
    state.bossFarmIdle = true
    state.bossFarmStatus = state.bossStreamBusy and state.bossSearchStatus
        or "No loaded selected boss; checking distant spawn areas"
end

