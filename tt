task.spawn(function()
    local lockedRoot
    local lockedTarget
    local nextScan = 0
    while state.running do
        local _dt = RunService.Heartbeat:Wait()
        refreshTrackedDeath()
        if not state.running or state.isHealing or state.travelOwner or state.defenseBusy then continue end
        if not state.crow1Enabled and (state.autoFarm or state.autoBossFarm or state.breathingCombat) and (not state.breathingTraining or state.breathingCombat)
            and not (state.autoBossFarm and state.bossFarmIdle and not state.breathingTraining)
            and state.target and not state.questBusy and not state.lootBusy then
            local playerRoot = getCharacterRoot()
            if playerRoot then
                local prioritizeLoot = lootHasPriority()
                if prioritizeLoot then state.currentMob=nil;continue end
                if not state.breathingTraining and state.autoFarm and state.autoQuest and state.target.quest
                    and not state.questHuntTripAllowed() then
                    state.currentMob=nil
                    state.lastFarmCFrame=nil
                    state.waitCFrame=nil
                    -- Acceptance/completion confirmation belongs to the quest worker.
                    continue
                end
                local pendingQuest = needsQuest()
                local model = lockedRoot and lockedRoot.Parent
                local humanoid = model and model:FindFirstChildOfClass("Humanoid")
                if lockedTarget ~= state.target or not model or not model:IsDescendantOf(workspace)
                    or not humanoid or humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then
                    lockedRoot = nil
                end
                if not lockedRoot and not prioritizeLoot and not pendingQuest and os.clock() >= nextScan then
                    nextScan = os.clock() + 0.05
                    lockedRoot = nearestLivingTarget(state.target)
                    lockedTarget = state.target
                    if lockedRoot then
                        state.standAtQuestNpc = false
                        state.trackedMob = { root = lockedRoot, target = state.target, position = lockedRoot.Position, done = false }
                        state.waitCFrame = nil
                        state.waitSettled = false
                    end
                end
                local mobRoot = not prioritizeLoot and not pendingQuest and lockedRoot or nil
                state.currentMob = mobRoot
                -- A lost/unloaded boss never authorizes travel to a guessed spawn.
                if state.autoBossFarm and not state.breathingTraining and not mobRoot then
                    state.bossFarmIdle = true
                    state.lastFarmCFrame = nil
                    continue
                end
                if mobRoot then
                    state.waitCFrame = nil
                    state.waitSettled = false
                    state.lastFarmCFrame = state.farmDestination(mobRoot, playerRoot)
                else
                    state.distanceStatus = prioritizeLoot and "Standing; collecting loot first"
                        or "Standing; waiting for target"
                    if not state.breathingTraining and state.autoFarm and state.autoQuest and not prioritizeLoot then
                        state.waitForQuestMob(playerRoot, pendingQuest)
                    else
                    local spawnPosition = getSpawnPosition(state.target)
                    if spawnPosition and (playerRoot.Position - spawnPosition).Magnitude > (state.autoBossFarm and 25 or 200)
                        and not prioritizeLoot and not pendingQuest
                        and os.clock() >= (state.nextDistantSearch or 0) then
                        -- A missing streamed model is not proof that the target is dead.
                        state.nextDistantSearch = os.clock() + 0.5
                        state.standAtQuestNpc = false
                        state.lastMobPosition = nil
                        state.waitCFrame = CFrame.new(spawnPosition + Vector3.new(0, 5, 0))
                        state.waitSettled = false
                        state.groundRefreshAt = os.clock() + 3
                        state.distanceStatus = "Travelling to target spawn; loading area"
                    end
                    if state.breathingTraining and state.breathingCombat then state.groundRefreshAt=nil end
                    if state.groundRefreshAt and os.clock() >= state.groundRefreshAt then
                        state.groundRefreshAt = nil
                        state.waitCFrame = nil
                        state.waitSettled = false
                    end
                    if not state.waitCFrame then
                        local position = state.standAtQuestNpc and playerRoot.Position
                            or state.lastMobPosition or getSpawnPosition(state.target) or playerRoot.Position
                        state.waitCFrame = groundWaitCFrame(position, playerRoot)
                        state.waitSettled = false
                    end
                    end
                    state.lastFarmCFrame = state.waitCFrame
                end
                local movementCFrame = state.lastFarmCFrame
                local waitingCFrame = state.waitCFrame
                if movementCFrame and (mobRoot or not state.waitSettled) then
                    -- Follow nearby during our skill; never start a new trip mid-cast.
                    local farmFollow = mobRoot and state.farmFollow
                    local followingLocked = farmFollow and farmFollow.root==playerRoot
                        and farmFollow.mob==mobRoot and farmFollow.target==state.target
                        and not state.breathingTraining
                    if state.skillBusy and not followingLocked
                        and (playerRoot.Position-movementCFrame.Position).Magnitude>12 then continue end
                    if not followingLocked and (playerRoot.Position - movementCFrame.Position).Magnitude > (mobRoot and 60 or 25) then
                        local selected = state.target
                        if not moveSmooth(playerRoot, movementCFrame, function()
                            return state.running and (state.autoFarm or state.autoBossFarm or state.breathingCombat)
                                and (not state.breathingTraining or state.breathingCombat) and not state.questBusy and not state.lootBusy
                                and state.target == selected
                                and (not mobRoot or (not lootHasPriority() and not needsQuest()))
                                and (not mobRoot or (mobRoot.Parent == model and humanoid.Health > 0))
                                and getCharacterRoot() == playerRoot
                        end,"World",state.breathingTraining and "Breathing" or (mobRoot and (state.autoFarm and state.autoQuest and "QuestHunt" or "MonsterFollow") or "Travel")) then continue end
                        if state.target ~= selected or state.defenseBusy or state.skillBusy
                            or not state.running or getCharacterRoot() ~= playerRoot then continue end
                        if mobRoot and mobRoot.Parent==model and humanoid.Health>0 then
                            -- Arrival can outlive the sampled boss pose; follow its live pose now.
                            state.writeMovement(playerRoot,state.farmDestination(mobRoot,playerRoot))
                        end
                    else
                        if not state.writeMovement(playerRoot, movementCFrame) then continue end
                    end
                    if not mobRoot and waitingCFrame
                        and (playerRoot.Position - waitingCFrame.Position).Magnitude < 0.3 then
                        -- Let the humanoid stand normally instead of pinning it every frame.
                        state.waitSettled = true
                    end
                end
            end
        elseif not state.crow1Enabled and not state.autoDungeonFarm and not state.autoFinalSelection then
            state.currentMob = nil
        end
    end
end)

