local dungeonDropRequests=setmetatable({}, {__mode="k"})
local function collectOneDungeonDrop()
    local root=getCharacterRoot()
    if not root or state.isHealing or state.travelOwner then return false end
    local userId=LocalPlayer.UserId
    local settings=require(ReplicatedStorage.CAM.Global.gameSettings)
    local lootTag=settings.Tags.LootDrop or "LootDrop"
    local inRange,nearest,nearestDistance={},nil,math.huge
    for _,item in ipairs(CollectionService:GetTagged(lootTag)) do
        if item and item:IsDescendantOf(workspace) and item:GetAttribute("Claimed")~=true then
            local owner=item:GetAttribute("DropOwnerUserId")
            local reserved=item:GetAttribute("DropReservedFor")
            local eligible=owner==nil or owner==userId
            if eligible and typeof(reserved)=="string" and reserved~="" then
                eligible=string.find(","..reserved..",",","..tostring(userId)..",",1,true)~=nil
            end
            local prompt=eligible and item:FindFirstChildWhichIsA("ProximityPrompt",true)
            local pivot=eligible and (item:IsA("Model") and item:GetPivot() or item:IsA("BasePart") and item.CFrame)
            if prompt and prompt.Enabled and pivot then
                local parent=prompt.Parent
                local position=parent:IsA("Attachment") and parent.WorldPosition
                    or parent:IsA("BasePart") and parent.Position or pivot.Position
                local distance=(position-root.Position).Magnitude
                local entry={item=item,prompt=prompt,pivot=pivot}
                if distance<=prompt.MaxActivationDistance then
                    inRange[#inRange+1]=entry
                elseif distance<nearestDistance then
                    nearest,nearestDistance=entry,distance
                end
            end
        end
    end
    if #inRange>0 then
        state.dungeonCacheStatus="Claiming all "..#inRange.." nearby drops"
        local now=os.clock()
        for _,entry in ipairs(inRange) do
            if state.running and state.autoOpenDungeonCaches and entry.prompt.Parent
                and now>=(dungeonDropRequests[entry.prompt] or 0) then
                dungeonDropRequests[entry.prompt]=now+0.25
                pcall(fireproximityprompt,entry.prompt,entry.prompt.HoldDuration)
            end
        end
        return true
    end
    if nearest then
        state.dungeonCacheStatus="Moving within range of remaining drops"
        moveSmooth(root,nearest.pivot*CFrame.new(0,2,2),function()
            return state.running and state.autoOpenDungeonCaches and nearest.item:IsDescendantOf(workspace)
                and not state.isHealing
        end,state.movementMode,"Loot")
        return true
    end
    return false
end

