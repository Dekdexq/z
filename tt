            tab:AddParagraph({Title = row._title or opts.Title or "Info", Content = text})
            local label, container
            for _, child in ipairs(tab._panel:GetChildren()) do
                if not previous[child] then
                    for _, item in ipairs(child:GetChildren()) do
                        -- Library versions use different font sizes for paragraph
                        -- content. Bind by its text, excluding the paragraph title.
                        if item:IsA("TextLabel") and item.Text == text
                            and item.Text ~= (row._title or opts.Title or "Info") then
                            label, container = item, child
                        end
                    end
                end
            end
            return setmetatable({ _text = text }, {
                __index = function(t, key) if key == "Text" then return rawget(t, "_text") end; return nil end,
                __newindex = function(t, key, value)
                    if key ~= "Text" then rawset(t, key, value); return end
                    if value == rawget(t, "_text") then return end
                    rawset(t, "_text", value)
                    if label and label.Parent then
                        label.Text = tostring(value)
                        task.defer(function()
                            if container.Parent then
                                container.Size = UDim2.new(1, -24, 0, math.max(50, 36 + label.AbsoluteSize.Y))
                            end
                        end)
                    end
                end,
            })
        end
        function row:KeybindField(opts)
            local proxy = wrapControl(nil, opts.Value)
            tab:AddKeybind({
                Title = row._title or opts.Title or "Keybind",
                Default = opts.Value,
                Callback = function(key)
                    if proxy then proxy.Value = key.Name end
                    if opts.ValueChanged then opts.ValueChanged(proxy, key.Name) end
                end
            })
            return proxy
        end
        return row
    end }
    function form:Form() return self end
    return form
end
