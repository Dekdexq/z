local function collectNearbyLoot()
    if state.breathingTraining then return end
    if state.travelOwner or state.defenseBusy or state.defenseMoving then return end
    refreshTrackedDeath()
    if state.lootBusy or state.questBusy or not (state.autoChest or state.autoLoot) then return end
    local root = getCharacterRoot()
    if not root then return end
    if not state.lootDrainPending and not nearestLoot(root, true) and os.clock() >= state.lootPriorityUntil then
        state.lootStatus = "No eligible loot remaining"
        return
    end
    local selected = state.target
    state.lootBatchOrigin = state.lootBatchOrigin or state.lastMobPosition
        or (state.lastFarmCFrame and state.lastFarmCFrame.Position) or root.Position
    local function valid()
        local humanoid = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
        return state.running and not state.breathingTraining and getCharacterRoot() == root and state.target == selected
            and (state.autoChest or state.autoLoot) and humanoid and humanoid.Health > 0
    end
    local function selectedKind(candidate)
        return candidate.kind == "Chest" and state.autoChest or candidate.kind == "Drop" and state.autoLoot
    end
    state.lootBusy = true
    state.lootDrainPending = true
    mouse1release()
    local drained = false
    local emptySince
    local emptyScans = 0
    local fastPickups={}
    local ok, err = pcall(function()
        while valid() do
            for drop in pairs(fastPickups) do
                if drop:GetAttribute("DropClaimedBy")==LocalPlayer.UserId then
                    state.lootCollected+=1
                    fastPickups[drop]=nil
                elseif not drop:IsDescendantOf(workspace) then
                    fastPickups[drop]=nil
                end
            end
            local pending = nearestLoot(root, true)
            if pending then
                emptySince = nil
                state.lootPriorityUntil = math.max(state.lootPriorityUntil, os.clock() + 0.35)
            else
                emptySince = emptySince or os.clock()
                emptyScans += 1
                if os.clock() - emptySince >= 0.6 and os.clock() >= state.lootPriorityUntil
                    and os.clock() >= (state.lootAwaitDropsUntil or 0) and emptyScans >= 3 then
                    drained = true
                    state.lootStatus = "Loot cleared; ready for quest"
                    break
                end
            end
            local candidate = nearestLoot(root)
            if candidate then
                emptyScans = 0
                local item, prompt = candidate.item, candidate.prompt
                fastPickups[item]=nil -- Selected item has its own confirmation counter.
                state.lootStatus = "Collecting " .. item.Name
                state.lootAttempts[item] = os.clock() + 0.35
                local travelPosition
                local function itemStillReady()
                    if not (valid() and selectedKind(candidate) and lootEligible(item,candidate.kind)
                        and prompt.Parent~=nil and prompt.Enabled and prompt:IsDescendantOf(item)) then return false end
                    local livePosition=lootPosition(prompt.Parent)
                    return livePosition~=nil and (not travelPosition
                        or (livePosition-travelPosition).Magnitude<=math.max(1,prompt.MaxActivationDistance-0.5))
                end
                if not itemStillReady() then continue end
                local targetPosition = lootPosition(prompt.Parent)
                if not targetPosition then continue end
                travelPosition=targetPosition
                local destination = CFrame.new(targetPosition)
                if (root.Position - targetPosition).Magnitude > math.max(0.5, prompt.MaxActivationDistance - 0.5) then
                    if not moveSmooth(root, destination, itemStillReady, "World", "Loot") then break end
                    task.wait() -- Give the prompt one frame to observe arrival.
                end
                if valid() and selectedKind(candidate) and lootEligible(item, candidate.kind)
                    and prompt.Parent and prompt.Enabled then
                    targetPosition = lootPosition(prompt.Parent) or targetPosition
                    if (root.Position - targetPosition).Magnitude <= prompt.MaxActivationDistance then
                        local claimed = false
                        local connection = item:GetAttributeChangedSignal("DropClaimedBy"):Connect(function()
                            if item:GetAttribute("DropClaimedBy") == LocalPlayer.UserId then claimed = true end
                        end)
                        local attemptOk, attemptError = pcall(function()
                            -- Collect other reachable drops in this same position.
                            -- Keep the selected item's acknowledgement below; pending
                            -- items remain visible to nearestLoot until the server claims them.
                            if state.autoLoot and type(fireproximityprompt)=="function" then
                                for _,drop in ipairs(CollectionService:GetTagged(gameSettings.Tags.LootDrop or "LootDrop")) do
                                    if drop~=item and lootEligible(drop,"Drop")
                                        and os.clock()>=(state.lootAttempts[drop] or 0) then
                                        for _,otherPrompt in ipairs(CustomQueryDescendants(drop,"ProximityPrompt")) do
                                            local otherPos=lootPosition(otherPrompt.Parent)
                                            if otherPrompt.Enabled and otherPos
                                                and (root.Position-otherPos).Magnitude<=otherPrompt.MaxActivationDistance then
                                                state.lootAttempts[drop]=os.clock()+0.4
                                                fastPickups[drop]=true
                                                pcall(fireproximityprompt,otherPrompt,otherPrompt.HoldDuration)
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                            if type(fireproximityprompt) == "function" then
                                fireproximityprompt(prompt, prompt.HoldDuration)
                            else
                                prompt:InputHoldBegin()
                                local holdUntil = os.clock() + prompt.HoldDuration
                                while os.clock() < holdUntil and valid() and prompt.Parent do task.wait(0.05) end
                                prompt:InputHoldEnd()
                            end
                            local deadline = os.clock() + 2
                            local nextTrigger = os.clock() + 0.35
                            repeat
                                if not valid() or not selectedKind(candidate) then return end
                                local confirmed = candidate.kind == "Chest"
                                    and (item:GetAttribute("IsOpen") == true or item:GetAttribute("ChestState") == "Opened")
                                    or candidate.kind == "Drop"
                                    and (claimed or item:GetAttribute("DropClaimedBy") == LocalPlayer.UserId)
                                if confirmed then
                                    state.lootFailures[item] = nil
                                    if candidate.kind == "Chest" then
                                        state.lootOpened = state.lootOpened + 1
                                        -- Chest acknowledgement precedes the replicated loot parts.
                                        -- Keep the boss queue locked while those parts arrive/land.
                                        state.lootAwaitDropsUntil = math.max(state.lootAwaitDropsUntil or 0, os.clock()+3)
                                        state.lootAnchors[#state.lootAnchors + 1] = { position = targetPosition, time = os.clock() }
                                    else
                                        state.lootCollected = state.lootCollected + 1
                                    end
                                    state.lootPriorityUntil = math.max(state.lootPriorityUntil,
                                        os.clock() + (candidate.kind == "Chest" and 0.6 or 0.35))
                                    state.lootStatus = "Confirmed: " .. item.Name
                                    return
                                end
                                if not item:IsDescendantOf(workspace) then
                                    if candidate.kind == "Chest" then
                                        state.lootAwaitDropsUntil = math.max(state.lootAwaitDropsUntil or 0, os.clock()+3)
                                    end
                                    state.lootPriorityUntil = math.max(state.lootPriorityUntil,
                                        os.clock() + (candidate.kind == "Chest" and 0.6 or 0.35))
                                    state.lootStatus = "Item removed; checking for remaining drops"
                                    return
                                end
                                -- Retry an unacknowledged interaction without leaving the chest.
                                if os.clock() >= nextTrigger and prompt.Parent and prompt.Enabled then
                                    local currentPosition = lootPosition(prompt.Parent)
                                    if currentPosition and (root.Position-currentPosition).Magnitude <= prompt.MaxActivationDistance then
                                        fireproximityprompt(prompt, prompt.HoldDuration)
                                    end
                                    nextTrigger = os.clock() + 0.35
                                end
                                task.wait(0.05)
                            until os.clock() >= deadline
                            state.lootFailures[item] = (state.lootFailures[item] or 0) + 1
                            state.lootAttempts[item] = os.clock() + math.min(1, 0.2 * state.lootFailures[item])
                            state.lootStatus = "Pickup pending; retrying before quest"
                        end)
                        connection:Disconnect()
                        if not attemptOk then
                            state.lootAttempts[item] = os.clock() + 2
                            state.lootStatus = "Pickup error; retrying"
                            warn("[Auto Loot] " .. tostring(attemptError))
                        end
                    end
                end
            else
                state.lootStatus = pending and "Waiting for loot prompt / retry; quest paused"
                    or "Checking that all drops have appeared"
                task.wait(0.05)
            end
        end
        if drained and valid() then
            state.lootBatchOrigin = nil
            state.lootBatchClosed = true
            state.lootDrainPending = false
            state.lootAwaitDropsUntil = 0
            state.lootAnchors = {}
            -- Release this kill's batch once. Farm/quest workers choose the next destination.
            state.waitCFrame = groundWaitCFrame(root.Position, root)
            state.lastFarmCFrame = state.waitCFrame
        end
    end)
    state.lootBusy = false
    priorityCandidate = nil
    nextPriorityScan = 0
    state.waitSettled = false
    if not ok then
        state.lootPriorityUntil = math.max(state.lootPriorityUntil, os.clock() + 2)
        state.lootStatus = "Collection error; retrying before quest"
        warn("[Auto Loot] " .. tostring(err))
    end
end

