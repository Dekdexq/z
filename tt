                        local r=root();local mr=target:FindFirstChild("HumanoidRootPart")
                        if r and mr then
                            local destination=movement.farmDestination(mr,r)
                            movement.writeMovement(r,destination,"Final")
                        end
                    else
                        S.debugStatus="Holding rescue zone; waiting for capture"
                        local r=root()
                        if r and (r.Position-pos).Magnitude>12 then travel(pos) end
                    end
                else S.status="Waiting for rescue zone";task.wait(0.5) end
            elseif names[chosen.Name] then
                local wanted=names[chosen.Name]
                local handDemonPhase=chosen.Name=="Hand Demon"
                if handDemonPhase then
                    -- Hand Demon becomes protected while its Rogue Demons are alive.
                    -- Re-evaluate this every tick so a newly spawned add immediately
                    -- preempts the boss, and return to the boss only after all adds die.
                    for _,m in ipairs(CustomQueryDescendants(workspace.Humanoids.Regions, "Model:has(Humanoid)")) do
                        local h=m:FindFirstChildOfClass("Humanoid")
                        if m.Name=="Rogue Demon" and h and h.Health>0 and m:FindFirstChild("HumanoidRootPart") then
                            wanted="Rogue Demon"
                            break
                        end
                    end
                end
                local target=S.target
                local hum=target and target:FindFirstChildOfClass("Humanoid")
                if not target or target.Name~=wanted or not target.Parent or not hum or hum.Health<=0 then
                    target=nil
                    for _,m in ipairs(CustomQueryDescendants(workspace.Humanoids.Regions, "Model:has(Humanoid)")) do
                        if m.Name==wanted and m.Humanoid.Health>0 and m:FindFirstChild("HumanoidRootPart") then
                            target=m;break
                        end
                    end
                    S.target=target
                end
                if target and wanted=="Rogue Demon" then hookRogueOneHit(target) end
                if not target then
                    if handDemonPhase and wanted=="Rogue Demon" then
                        S.status="Waiting for spawned Rogue Demon"
                    elseif marker and marker.Position then
                        travel(marker.Position)
                    end
                    task.wait(0.3);return
                end
                if handDemonPhase then
                    S.status=wanted=="Rogue Demon"
                        and "Hand Demon shielded: clearing Rogue Demons first"
                        or "All Rogue Demons cleared: attacking Hand Demon"
                end
                local mr=target.HumanoidRootPart;local r=root()
                if not r or not mr then return end
                local targetHP=target.Humanoid.Health
                combatHeight=handDemonPhase and 6 or 7
                if trackedTarget~=target or (lastTargetHP and targetHP<lastTargetHP) then
                    trackedTarget=target;damageDeadline=os.clock()+20
                end
                lastTargetHP=targetHP
                if os.clock()<(movement.movementRetryAt or 0) then
                    damageDeadline=os.clock()+20
                    S.status=movement.distanceStatus
                    task.wait(0.1)
                    return
                end
                if movement.autoAttack ~= true then damageDeadline=os.clock()+20 end
                if damageDeadline and os.clock()>damageDeadline then
                    S.recover("No target damage for 20s; reacquiring target and weapon")
                    damageDeadline=os.clock()+20;trackedTarget=nil;lastTargetHP=nil
                    local equipped=P:FindFirstChild("Items_Config") and P.Items_Config:FindFirstChild("Equipped")
                    if equipped then R:FireServer("Item_Equip",1) end
                    S.status="Recovering combat; retrying current task"
                    return
                end
                local g=getgenv().FinalSelectionGuard
                if g and g.healing then return end
                local equipped=P:FindFirstChild("Items_Config") and P.Items_Config:FindFirstChild("Equipped")
                if equipped and equipped.Value==0 then equipped.Value=1;R:FireServer("Item_Equip",1);task.wait(0.3) end
                if not canRun() then return end
                local destination=CFrame.lookAt(mr.Position+Vector3.new(0,combatHeight,0),mr.Position,Vector3.zAxis)
                if movement.farmDestination then destination=movement.farmDestination(mr,r) end
                if not movement.writeMovement(r,destination,"Final") then return end

                if movement.autoAttack ~= true then
                    S.status=key.." / "..chosen.Name.." — Enable Auto Attack in Combat"
                end
                task.wait(0.03)
            else
                S.target=nil;S.status="Needs specialized handler: "..key.." / "..chosen.Name;task.wait(1)
            end
        end)
        if not ok then
            S.error=tostring(err);S.status="Task retry: "..S.error
            S.debugStatus=S.status;task.wait(1)
        end
        task.wait(0.05)
    end
    if S.followConnection then S.followConnection:Disconnect();S.followConnection=nil end
    if movement.movementMode=="Final" and getgenv().ExamRunner==S then movement.movementMode="World" end
end)

