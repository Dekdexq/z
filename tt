local function noop() end
local function wrapControl(control, initial)
    local proxy = { Value = initial, _control = control }
    return proxy
end
local function addToggle(tab, title, value, callback, subtitle, flag)
    local proxy, syncing
    local c = tab:AddToggle({Title = title, Description = subtitle or "", Default = value == true,
        Flag = flag or "Slayer_" .. title:gsub("[^%w]", "_"), Callback = function(v)
            if proxy then rawset(proxy, "_value", v) end
            if syncing then return end
            callback(proxy, v)
        end})
    proxy = setmetatable({ _control = c, _value = value == true }, {
        __index = function(t, key)
            if key == "Value" then return rawget(t, "_value") end
            return nil
        end,
        __newindex = function(t, key, v)
            if key ~= "Value" then rawset(t, key, v); return end
            if rawget(t, "_value") == v then return end
            rawset(t, "_value", v)
            syncing = true
            local ok, err = pcall(c.Set, v)
            syncing = false
            if not ok then warn("[Toggle] " .. tostring(err)) end
        end,
    })
    return proxy
end
local function addDropdown(tab, title, options, index, callback, subtitle, maximum)
    local multi = maximum ~= nil and maximum > 1
    local default = options[index] or options[1]
    if multi then
        default = {}
        for _, i in ipairs(type(index) == "table" and index or {}) do
            if options[i] then default[#default + 1] = options[i] end
        end
    end
    local c = tab:AddDropdown({Title = title, Description = subtitle or "", Options = options,
        Default = default, Multi = multi, Flag = "Slayer_" .. title:gsub("[^%w]", "_"), Callback = function(v)
            if multi then
                local indices = {}
                for _, name in ipairs(type(v) == "table" and v or {}) do
                    local i = table.find(options, name)
                    if i then indices[#indices + 1] = i end
                end
                callback(indices, v)
                return
            end
            local i = table.find(options, v) or tonumber(v) or 1
            callback(i, v)
        end})
    return wrapControl(c, index or 1)
end
