local function finalSelectionCountdown()
    local every = 7200
    local ok, config = pcall(require, ReplicatedStorage.CAM.Global.Subsets.Gameplay.TimedEvents)
    if ok and config.FinalSelection and type(config.FinalSelection.Every) == "number" then
        every = config.FinalSelection.Every
    end
    return math.max(0, every - workspace:GetServerTimeNow() % every)
end

local function formatCountdown(seconds)
    seconds = math.max(0, math.floor(seconds))
    return string.format("%02d:%02d:%02d", math.floor(seconds / 3600), math.floor(seconds / 60) % 60, seconds % 60)
end

