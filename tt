function state.smartIsBoss(target)
    return target.name=="Zuko" or target.name=="Mother Bear" or target.name=="Kaiden" or target.name=="Hoyuzo"
end

function state.smartTargetEligible(target,level)
    if not target or not target.quest or target.level>level then return false end
    local info=Quests.Holder[target.quest]
    if not info then return false end
    local requirements=info.Requirements or {}
    if requirements.Level and level<requirements.Level then return false end
    if type(requirements.Race)=="table" then
        local data=QuestUtility.GetData(LocalPlayer)
        local race=data and data:FindFirstChild("Race") and data.Race.Value
        local allowed=false
        for _,value in pairs(requirements.Race) do
            if value==race then allowed=true;break end
        end
        if not allowed then return false end
    end
    -- Beast Born Demons are a night-only spawn. Exclude them during the day
    -- so Smart Farm immediately falls back to the best repeatable daytime quest.
    if target.name=="Beast Born Demon" and DayAndNightHandler.IsEnabled()
        and not DayAndNightHandler.IsNight() then return false end
    return true
end

function state.smartChooseTarget(level, living)
    local best, waiting
    for _,target in ipairs(targets) do
        -- Village Spy is a separate objective; use the repeatable combat route.
        if target.name~="Village Spy" and state.smartTargetEligible(target,level) then
            if state.smartIsBoss(target) and not living(target) then
                if not waiting or target.level>waiting.level then waiting=target end
            elseif not best or target.level>best.level then best=target end
        end
    end
    if waiting and best and waiting.level<best.level then waiting=nil end
    return best,waiting
end

function state.updateSmartFarm()
    if not state.smartFarm or not state.autoFarm or not state.autoQuest or state.autoBossFarm
        or state.autoDungeonFarm or state.crow1Enabled or state.breathingTraining then return end
    local data=QuestUtility.GetData(LocalPlayer)
    local exp=data and data:FindFirstChild("Exp")
    local goal=exp and exp:FindFirstChild("Goal")
    if not goal or not gameSettings.expPerLevel or gameSettings.expPerLevel<=0 then
        state.smartStatus="Waiting for level data";return
    end
    local level=math.floor(goal.Value/gameSettings.expPerLevel)
    local nextTarget,waiting=state.smartChooseTarget(level,nearestLivingTarget)
    local race=data and data:FindFirstChild("Race") and data.Race.Value or "Unknown"
    local night=not DayAndNightHandler.IsEnabled() or DayAndNightHandler.IsNight()
    local phase=night and "Night" or "Day"
    local beastNote=(level>=47 and level<62 and not night)
        and string.format(" | Beast Born in %.0fs",DayAndNightHandler.SecondsUntilPhaseChange()) or ""
    state.smartStatus=string.format("Lv %d %s | %s | %s%s%s",level,race,phase,
        nextTarget and nextTarget.name or "No eligible quest",
        waiting and (" | Waiting: "..waiting.name) or "",beastNote)
    -- Stream one eligible boss area without moving the player out of the current quest.
    if waiting and not state.smartStreamBusy and os.clock()>=state.smartStreamNextAt
        and not state.travelOwner and not state.lootBusy and not lootHasPriority() then
        local position=getSpawnPosition(waiting)
        if position and type(LocalPlayer.RequestStreamAroundAsync)=="function" then
            state.smartStreamBusy=true;state.smartStreamNextAt=os.clock()+5
            task.spawn(function()
                local identity=getthreadidentity();setthreadidentity(2)
                pcall(function()LocalPlayer:RequestStreamAroundAsync(position,2)end)
                setthreadidentity(identity);state.smartStreamBusy=false
            end)
        end
    end
    if not nextTarget or nextTarget==state.target or state.questBusy or state.travelOwner
        or state.lootBusy or lootHasPriority() or state.defenseBusy then return end
    -- Finish the exact living boss and its loot before promoting to another quest.
    local tracked=state.trackedMob
    if state.smartIsBoss(state.target) and tracked and tracked.target==state.target and not tracked.done then return end
    state.releaseNpcHold()
    state.target=nextTarget;state.currentMob=nil;state.trackedMob=nil
    state.lastFarmCFrame=nil;state.waitCFrame=nil;state.waitSettled=false;state.standAtQuestNpc=false
    state.observedQuest=nil;state.observedQuestState=nil;state.questMissingSince=nil
    state.lastQuestRequest=-math.huge;state.lastQuestCancel=-math.huge;state.questStreamNextAt=0
    state.questStatus="Smart selected "..nextTarget.name.."; checking quest"
    -- The existing quest worker cancels the previous combat quest before acceptance.
