local questSession={key=nil,entry=nil,complete=false,remaining=math.huge,connections={}}
local function questTasksComplete(entry)
    local tasks=entry and entry:FindFirstChild("Tasks")
    if not tasks then return false end
    local count,remaining=0,0
    for _,taskInfo in ipairs(tasks:GetChildren()) do
        local value=taskInfo:FindFirstChild("Value")
        local maximum=taskInfo:FindFirstChild("Max")
        if not value or not maximum or maximum.Value<=0 then return false,math.huge end
        remaining+=math.max(0,maximum.Value-value.Value)
        count+=1
    end
    return count>0 and remaining==0,remaining
end
local function watchQuestEntry(quest,entry)
    if questSession.key==quest and questSession.entry==entry then
        local complete,remaining=questTasksComplete(entry)
        questSession.complete=questSession.complete or complete
        if remaining then questSession.remaining=remaining end
        return
    end
    for _,connection in ipairs(questSession.connections) do connection:Disconnect() end
    local complete,remaining=questTasksComplete(entry)
    questSession={key=quest,entry=entry,complete=complete,remaining=remaining or math.huge,connections={}}
    local session=questSession
    if not entry then return end
    local function changed()
        if questSession==session then
            local complete,remaining=questTasksComplete(entry)
            session.complete=session.complete or complete
            if remaining then session.remaining=remaining end
        end
    end
    local function bind(value)
        if value:IsA("ValueBase") and (value.Name=="Value" or value.Name=="Max") then
            session.connections[#session.connections+1]=value:GetPropertyChangedSignal("Value"):Connect(changed)
        end
    end
    for _,value in ipairs(entry:QueryDescendants("ValueBase")) do bind(value) end
    session.connections[#session.connections+1]=entry.DescendantAdded:Connect(function(value)bind(value);changed()end)
end

local function selectedQuestPhase(quest)
    if questSession.key and questSession.key~=quest then watchQuestEntry(quest,nil) end
    local ok,status=pcall(Quests.GetPlayerQuestState,LocalPlayer,quest)
    local locked=state.observedQuest==quest and state.observedQuestState=="Doing"
    if not ok then return locked and "Hunt" or "Wait" end
    local data=QuestUtility.GetData(LocalPlayer)
    local quests=data and data:FindFirstChild("Quests")
    local holder=quests and quests:FindFirstChild("Holder")
    if not holder then return locked and "Hunt" or "Wait" end
    local info=Quests.GetQuestInfo and Quests.GetQuestInfo(quest) or Quests.Holder[quest]
    local found=info and info.QuestInstance and holder:FindFirstChild(info.QuestInstance.Name)
    for _,entry in ipairs(holder:GetChildren()) do
        local key=entry:FindFirstChild("QuestString")
        if key and key.Value==quest then found=entry;break end
    end
    if found or status=="Doing" then
        if found then watchQuestEntry(quest,found) end
        state.observedQuest=quest;state.observedQuestState="Doing";state.questMissingSince=nil
        return questSession.key==quest and questSession.complete and "Wait" or "Hunt"
    end
    if state.observedQuest==quest and state.observedQuestState=="Doing" then
        state.questMissingSince=state.questMissingSince or os.clock()
        local completed=questSession.key==quest and questSession.complete
        if not completed and questSession.key==quest and questSession.entry
            and questSession.entry.Parent==nil and state.lastQuestKillKey==quest
            and os.clock()-(state.lastQuestKillAt or 0)<15
            and os.clock()-state.questMissingSince>=0.3 then completed=true end
        if not completed and questSession.key==quest and questSession.remaining==1
            and state.lastQuestKillKey==quest and os.clock()-(state.lastQuestKillAt or 0)<8
            and os.clock()-state.questMissingSince>=0.3 then completed=true end
        -- A completed/cancelled quest may disappear without a final task update.
        -- Require sustained native absence and destruction of the watched entry;
        -- a transient empty holder alone must never send the hunter back to the NPC.
        local removed=questSession.key==quest and questSession.entry and questSession.entry.Parent==nil
            and status=="None" and os.clock()-state.questMissingSince>=6
        if not completed and not removed and (status~="Done" or os.clock()-state.questMissingSince<0.8) then return "Hunt" end
        state.observedQuestState="Done";state.questMissingSince=nil
        state.lastQuestRequest=-math.huge
        watchQuestEntry(quest,nil)
    end
    return "Accept"
end

