local function openAllOuwigaharaCaches()
    if state.dungeonCacheBusy or not state.autoOpenDungeonCaches
        or workspace:GetAttribute("MinigameKey") ~= "Ouwigahara" then return end
    local caches = pendingOuwigaharaCaches()
    if #caches == 0 then
        state.dungeonCacheStatus = "No earned caches waiting"
        return
    end
    state.dungeonCacheBusy = true
    task.spawn(function()
        local ok, err = pcall(function()
            for index, entry in ipairs(caches) do
                if not state.running or not state.autoOpenDungeonCaches then break end
                local prompt, model = entry.prompt, entry.model
                if prompt.Parent and model.Parent and prompt.Enabled then
                    local root = getCharacterRoot()
                    if not root then error("Character root unavailable") end
                    state.dungeonCacheStatus = string.format("Opening cache %d/%d", index, #caches)
                    local moved = moveSmooth(root, model:GetPivot() * CFrame.new(0, 0, 4), function()
                        return state.running and state.autoOpenDungeonCaches and prompt.Parent ~= nil
                    end,state.movementMode,"Loot")
                    if moved and prompt.Parent and prompt.Enabled then
                        fireproximityprompt(prompt, prompt.HoldDuration)
                        local deadline = os.clock() + 2
                        repeat task.wait(0.1) until not prompt.Parent or not prompt.Enabled or os.clock() >= deadline
                    end
                end
            end
        end)
        state.dungeonCacheBusy = false
        if ok then
            local remaining = #pendingOuwigaharaCaches()
            state.dungeonCacheStatus = remaining == 0 and "All earned caches opened"
                or string.format("%d cache(s) still waiting", remaining)
        else
            state.dungeonCacheStatus = "Cache error: " .. tostring(err)
        end
    end)
end
