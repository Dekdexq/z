local function hookDungeonHumanoid(humanoid)
    if state.dungeonOneHitHooked[humanoid] then return end
    local model = humanoid.Parent
    if not model or isPlayerCharacter(model) then return end
    state.dungeonOneHitHooked[humanoid] = true
    local connection = humanoid.HealthChanged:Connect(function(newHealth)
        if not state.running or not state.autoAttack or not state.dungeonOneHitEnabled
            or workspace:GetAttribute("MinigameKey") ~= "Ouwigahara"
            or newHealth <= 0 or humanoid.MaxHealth <= 0
            or newHealth >= humanoid.MaxHealth then return end
        pcall(function() humanoid.Health = 0 end)
    end)
    state.dungeonOneHitConnections[#state.dungeonOneHitConnections + 1] = connection
end

